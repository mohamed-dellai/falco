tems-baseline gap-2\" data-kid=\"1-1-2-2-2-2-4-1\">\n                                <span class=\"text-[11.5px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-1-1\">\n                                    Nights\n                                </span>\n                                <span class=\"tnum text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-4-1-2\">\n                                    7\n                                </span>\n                            </div>\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-2-2-2-2-4-2\">\n                                <span class=\"text-[11.5px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-2-1\">\n                                    Rooms\n                                </span>\n                                <span class=\"tnum text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-4-2-2\">\n                                    10\n                                </span>\n                            </div>\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-2-2-2-2-4-3\">\n                                <span class=\"text-[11.5px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-3-1\">\n                                    Cost\n                                </span>\n                                <span class=\"tnum text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-4-3-2\">\n                                    SAR 15,120\n                                </span>\n                            </div>\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-2-2-2-2-4-4\">\n                                <span class=\"text-[11.5px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-4-1\">\n                                    Sell\n                                </span>\n                                <span class=\"tnum text-[15px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-4-4-2\">\n                                    SAR 20,020\n                                </span>\n                            </div>\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-1-2-2-2-2-4-5\">\n                                <span class=\"text-[11.5px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-5-1\">\n                                    Margin\n                                </span>\n                                <span class=\"tnum text-[15px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-4-5-2\">\n                                    SAR 4,900\n                                </span>\n                                <span class=\"tnum rounded-full bg-[var(--desk-success-soft)] px-2 py-0.5 text-[11.5px] font-semibold text-[var(--desk-success-ink)]\" data-kid=\"1-1-2-2-2-2-4-5-3\">\n                                    24.5% of sell\n                                </span>\n                            </div>\n                            <p class=\"w-full text-right text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-4-6\">\n                                Booking totals, not per-night figures. Margin excludes VAT.\n                            </p>\n                        </div>\n                    </section>\n                    <!-- add a room -->\n                    <section class=\"mt-4 rounded-xl border border-[var(--desk-line)] bg-white\" data-kid=\"1-1-2-2-2-3\">\n                        <header class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[var(--desk-line-soft)] px-4 py-3\" data-kid=\"1-1-2-2-2-3-1\">\n                            <div data-kid=\"1-1-2-2-2-3-1-1\">\n                                <h2 class=\"text-[15px] font-semibold tracking-tight text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-3-1-1-1\">\n                                    Add a room\n                                </h2>\n                                <p class=\"mt-0.5 text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-1-1-2\">\n                                    Choose where the room comes from before setting quantities.\n                                </p>\n                            </div>\n                            <div class=\"inline-flex rounded-lg border border-[var(--desk-line)] bg-[var(--desk-surface-muted)] p-0.5\" data-kid=\"1-1-2-2-2-3-1-2\">\n                                <button class=\"min-h-8 rounded-md bg-white px-3 text-[12.5px] font-semibold text-[var(--desk-ink)] shadow-sm\" data-kid=\"1-1-2-2-2-3-1-2-1\">\n                                    From contract allotment\n                                </button>\n                                <button class=\"min-h-8 rounded-md px-3 text-[12.5px] font-medium text-[var(--desk-muted)] hover:text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-3-1-2-2\">\n                                    Hotel direct\n                                </button>\n                            </div>\n                        </header>\n                        <div class=\"grid grid-cols-2 gap-x-4 gap-y-3.5 px-4 py-4 lg:grid-cols-6\" data-kid=\"1-1-2-2-2-3-2\">\n                            <label class=\"grid gap-1.5\" data-kid=\"1-1-2-2-2-3-2-1\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-1-1\">\n                                    Room type\n                                </span>\n                                <select class=\"dfield\" data-kid=\"1-1-2-2-2-3-2-1-2\">\n                                    <option data-kid=\"1-1-2-2-2-3-2-1-2-1\">\n                                        Solo\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-1-2-2\" selected=\"\">\n                                        Double\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-1-2-3\">\n                                        Triple\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-1-2-4\">\n                                        Quad\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"grid gap-1.5\" data-kid=\"1-1-2-2-2-3-2-2\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-2-1\">\n                                    Meals\n                                </span>\n                                <select class=\"dfield\" data-kid=\"1-1-2-2-2-3-2-2-2\">\n                                    <option data-kid=\"1-1-2-2-2-3-2-2-2-1\">\n                                        No meals\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-2-2-2\">\n                                        Breakfast\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-2-2-3\" selected=\"\">\n                                        Half board\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-2-2-4\">\n                                        Full board\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"grid gap-1.5\" data-kid=\"1-1-2-2-2-3-2-3\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-3-1\">\n                                    Views\n                                </span>\n                                <select class=\"dfield\" data-kid=\"1-1-2-2-2-3-2-3-2\">\n                                    <option data-kid=\"1-1-2-2-2-3-2-3-2-1\" selected=\"\">\n                                        City view\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-3-2-2\">\n                                        Haram view\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"grid gap-1.5 lg:col-span-2\" data-kid=\"1-1-2-2-2-3-2-4\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-4-1\">\n                                    Contract period\n                                </span>\n                                <select class=\"dfield\" data-kid=\"1-1-2-2-2-3-2-4-2\">\n                                    <option data-kid=\"1-1-2-2-2-3-2-4-2-1\" selected=\"\">\n                                        Nov 2026 · season A — 8 left\n                                    </option>\n                                    <option data-kid=\"1-1-2-2-2-3-2-4-2-2\">\n                                        Oct 2026 · season A — On request\n                                    </option>\n                                </select>\n                                <span class=\"text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-4-3\">\n                                    Period runs 1 Oct 2026 → 31 Jan 2027.\n                                </span>\n                            </label>\n                            <label class=\"grid gap-1.5\" data-kid=\"1-1-2-2-2-3-2-5\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-5-1\">\n                                    Available\n                                </span>\n                                <input aria-label=\"Rooms available on this contract period\" class=\"dfield tnum bg-[var(--desk-surface-muted)] text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-2-3-2-5-2\" disabled=\"\" value=\"8 rooms\"/>\n                            </label>\n                            <div class=\"grid grid-cols-[120px_minmax(0,1fr)] items-end gap-4 lg:col-span-6\" data-kid=\"1-1-2-2-2-3-2-6\">\n                                <label class=\"grid gap-1.5\" data-kid=\"1-1-2-2-2-3-2-6-1\">\n                                    <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-6-1-1\">\n                                        Quantity\n                                    </span>\n                                    <input class=\"dfield tnum\" data-kid=\"1-1-2-2-2-3-2-6-1-2\" max=\"5000\" min=\"1\" type=\"number\" value=\"2\"/>\n                                </label>\n                                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-2-2-3-2-6-2\">\n                                    <input class=\"cbx size-4\" data-kid=\"1-1-2-2-2-3-2-6-2-1\" disabled=\"\" id=\"ob\" type=\"checkbox\"/>\n                                    <label class=\"text-[13px] font-medium text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-2-3-2-6-2-2\" for=\"ob\">\n                                        Use the overbook allowance\n                                    </label>\n                                    <span class=\"text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-3-2-6-2-3\">\n                                        — only after the contract quantity is used up.\n                                    </span>\n                                </div>\n                                <button class=\"col-span-2 flex min-h-10 w-fit items-center justify-center gap-2 rounded-full bg-[var(--desk-primary)] px-4 text-[13px] font-semibold text-white hover:bg-[var(--desk-primary-hover)]\" data-kid=\"1-1-2-2-2-3-2-6-3\">\n                                    <i aria-hidden=\"true\" class=\"icon-plus text-[14px]\" data-kid=\"1-1-2-2-2-3-2-6-3-1\">\n                                    </i>\n                                    Add room to reservation\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                </main>\n            </div>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-15T09:37:42.947968+00:00",
