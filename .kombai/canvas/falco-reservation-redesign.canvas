      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n:root {\n  --desk-canvas: #f8fafc;\n  --desk-surface: #ffffff;\n  --desk-surface-muted: #f1f5f9;\n  --desk-ink: #15375e;\n  --desk-text: #414649;\n  --desk-text-soft: #64748b;\n  --desk-muted-soft: #94a3b8;\n  --desk-primary: #2d60e0;\n  --desk-primary-hover: #1d4ed8;\n  --desk-primary-deep: #0046c3;\n  --desk-primary-soft: #eff6ff;\n  --desk-info-line: #bfdbfe;\n  --desk-line: #e2e8f0;\n  --desk-line-soft: #f1f5f9;\n  --desk-line-strong: #cbd5e1;\n  --desk-gold: #c59b27;\n  --desk-success-ink: #047857;\n  --desk-success-soft: #ecfdf5;\n  --desk-success-line: #a7f3d0;\n  --desk-warning-ink: #b45309;\n  --desk-warning-soft: #fffbeb;\n  --desk-warning-line: #fde68a;\n  --desk-danger-ink: #b91c1c;\n}\n.num { font-variant-numeric: tabular-nums; }\n.mono { font-family: \"IBM Plex Mono\", ui-monospace, monospace; }\n.i { font-style: normal; line-height: 1; display: inline-flex; align-items: center; justify-content: center; font-family: \"lucide\" !important; }\n</style>\n<div class=\"flex min-h-screen items-start bg-[var(--desk-canvas)] font-[var(--font-desk)] text-[var(--desk-text)]\" data-kid=\"1\" style=\"font-family:'Plus Jakarta Sans',ui-sans-serif,system-ui,sans-serif\">\n    <!-- ══════════ APP ICON RAIL ══════════ -->\n    <aside class=\"sticky top-0 flex h-screen w-16 shrink-0 flex-col items-center border-e border-[var(--desk-line)] bg-white py-3\" data-kid=\"1-1\">\n        <div class=\"flex size-9 items-center justify-center rounded-lg bg-[#0f2942] text-white\" data-kid=\"1-1-1\">\n            <span class=\"text-[15px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\">\n                F\n            </span>\n        </div>\n        <div class=\"mt-5 flex flex-col items-center gap-1\" data-kid=\"