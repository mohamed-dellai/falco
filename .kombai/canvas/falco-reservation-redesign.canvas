      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap\");\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  @layer base {\n    :root {\n      --desk-canvas: #f8fafc;\n      --desk-surface: #ffffff;\n      --desk-surface-muted: #f1f5f9;\n      --desk-ink: #15375e;\n      --desk-text: #414649;\n      --desk-text-soft: #64748b;\n      --desk-muted: #64748b;\n      --desk-muted-soft: #94a3b8;\n      --desk-primary: #2d60e0;\n      --desk-primary-deep: #0046c3;\n      --desk-primary-soft: #eff6ff;\n      --desk-info-line: #bfdbfe;\n      --desk-line: #e2e8f0;\n      --desk-line-soft: #f1f5f9;\n      --desk-line-strong: #cbd5e1;\n      --desk-gold: #c59b27;\n      --desk-warning-soft: #fffbeb;\n      --desk-warning-line: #fde68a;\n      --desk-success-soft: #ecfdf5;\n      --desk-danger-soft: #fef2f2;\n      --desk-success-ink: #047857;\n      --desk-warning-ink: #b45309;\n      --desk-danger-ink: #b91c1c;\n      --desk-control-height: 2.25rem;\n      --font-desk: \"Plus Jakarta Sans\", sans-serif;\n      --font-mono: \"IBM Plex Mono\", ui-monospace, monospace;\n    }\n    body {\n      margin: 0;\n      font-family: var(--font-desk);\n      background: var(--desk-canvas);\n      color: var(--desk-text);\n      -webkit-font-smoothing: antialiased;\n    }\n  }\n\n  .num { font-variant-numeric: tabular-nums; }\n  .mono { font-family: var(--font-mono); }\n  @layer components {\n    .fld {\n      min-height: var(--desk-control-height);\n      border: 1px solid var(--desk-line);\n      border-radius: 0.5rem;\n      background: #fff;\n      padding: 0.5rem 0.75rem;\n      color: var(--desk-ink);\n      font-size: 0.875rem;\n      line-height: 1.25rem;\n      outline: none;\n    }\n  }\n  .caret-down::after {\n    content: \"\";\n    position: absolute;\n    right: 0.8rem;\n    top: 50%;\n    width: 0.4rem; height: 0.4rem;\n    border-right: 1.5px solid var(--desk-muted);\n    border-bottom: 1.5px solid var(--desk-muted);\n    transform: translateY(-70%) rotate(45deg);\n  }\n  .menu-shadow { box-shadow: 0 18px 40px -18px rgb(8 28 54 / 45%); }\n  .dialog-shadow { box-shadow: 0 28px 72px -28px rgb(8 28 54 / 55%); }\n  i[class^=\"icon-\"] { font-style: normal; line-height: 1; display: inline-block; }\n</style>\n<div class=\"relative min-h-screen bg-[var(--desk-canvas)] text-[var(--desk-text)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ================= APP ICON RAIL ================= -->\n    <aside class=\"fixed left-0 top-0 flex h-full w-16 flex-col items-center border-r border-[var(--desk-line)] bg-white py-3\" data-kid=\"1-1\" data-name=\"app icon rail sidebar\">\n        <div class=\"flex size-9 items-center justify-center rounded-lg bg-[var(--desk-ink)] text-sm font-bold text-white\" data-kid=\"1-1-1\" data-name=\"app logo badge\">\n            F\n        </div>\n        <nav class=\"mt-5 flex flex-col items-center gap-1.5 text-[15px]\" data-kid=\"1-1-2\" data-name=\"sidebar navigation\">\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav item\">\n                <i class=\"icon-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"layout dashboard icon\">\n                </i>\n            </span>\n            <span class=\"relative flex size-9 items-center justify-center rounded-lg bg-[var(--desk-primary-soft)] text-[var(--desk-primary)]\" data-kid=\"1-1-2-2\" data-name=\"active reservations nav item\">\n                <i class=\"icon-bed-double\" data-kid=\"1-1-2-2-1\" data-name=\"bed icon\">\n                </i>\n                <span class=\"absolute right-1.5 top-1.5 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-1-2-2-2\" data-name=\"gold notification dot\">\n                </span>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-3\" data-name=\"reports nav item\">\n                <i class=\"icon-chart-column\" data-kid=\"1-1-2-3-1\" data-name=\"column chart icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-4\" data-name=\"hotels nav item\">\n                <i class=\"icon-building-2\" data-kid=\"1-1-2-4-1\" data-name=\"building icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-5\" data-name=\"services nav item\">\n                <i class=\"icon-layers\" data-kid=\"1-1-2-5-1\" data-name=\"layers icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-6\" data-name=\"task list nav item\">\n                <i class=\"icon-clipboard-list\" data-kid=\"1-1-2-6-1\" data-name=\"clipboard list icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-7\" data-name=\"clients nav item\">\n                <i class=\"icon-users\" data-kid=\"1-1-2-7-1\" data-name=\"users icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-8\" data-name=\"completed nav item\">\n                <i class=\"icon-circle-check\" data-kid=\"1-1-2-8-1\" data-name=\"circle check icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-9\" data-name=\"files nav item\">\n                <i class=\"icon-folder-open\" data-kid=\"1-1-2-9-1\" data-name=\"folder open icon\">\n                </i>\n            </span>\n            <span class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-10\" data-name=\"settings nav item\">\n                <i class=\"icon-settings\" data-kid=\"1-1-2-10-1\" data-name=\"settings icon\">\n                </i>\n            </span>\n        </nav>\n        <div class=\"mt-auto flex size-8 items-center justify-center rounded-full bg-[var(--desk-ink)] text-[11px] font-semibold text-white\" data-kid=\"1-1-3\" data-name=\"user initials avatar\">\n            N\n        </div>\n    </aside>\n    <div class=\"ml-16\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- ================= TOP BAR ================= -->\n        <header class=\"flex h-14 items-center justify-between border-b border-[var(--desk-line)] bg-white px-6\" data-kid=\"1-2-1\" data-name=\"top bar header\">\n            <div class=\"flex items-baseline gap-2 text-[13px]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\">\n                <span class=\"mono text-[12px] font-medium text-[var(--desk-ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"reservation code breadcrumb\">\n                    A00015\n                </span>\n                <span class=\"text-[var(--desk-muted-soft)]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-1-1-3\" data-name=\"section name breadcrumb\">\n                    Reservations\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"top bar actions container\">\n                <div class=\"relative w-72\" data-kid=\"1-2-1-2-1\" data-name=\"search field container\">\n                    <i class=\"icon-search absolute left-3 top-1/2 -translate-y-1/2 text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                    <input class=\"fld w-full pl-9 text-[13px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"search input field\" placeholder=\"Search hotels and reservations\"/>\n                </div>\n                <div class=\"num flex h-9 items-center gap-2 rounded-lg border border-[var(--desk-line)] px-3 text-[12px]\" data-kid=\"1-2-1-2-2\" data-name=\"currency exchange rate widget\">\n                    <span class=\"font-semibold text-[var(--desk-gold)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"currency pair label\">\n                        SAR / USD\n                    </span>\n                    <span class=\"font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"exchange rate value\">\n                        3.7500\n                    </span>\n                </div>\n                <span class=\"relative flex size-9 items-center justify-center rounded-lg text-[15px] text-[var(--desk-muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3\" data-name=\"notifications button\" data-reason=\"badge dot and state driven by notification data via script\">\n                    <i class=\"icon-bell\" data-kid=\"1-2-1-2-3-1\" data-name=\"bell icon\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2\" data-name=\"gold notification dot\" data-reason=\"dot visibility/count driven by notification data via script\">\n                    </span>\n                </span>\n                <span class=\"flex size-8 items-center justify-center rounded-full bg-[var(--desk-ink)] text-[11px] font-semibold text-white\" data-kid=\"1-2-1-2-4\" data-name=\"user initials avatar\">\n                    MD\n                </span>\n            </div>\n        </header>\n        <!-- ================= RECORD ================= -->\n        <div class=\"mx-auto grid max-w-[1600px] grid-cols-[320px_minmax(0,1fr)] items-start gap-5 px-6 py-5\" data-kid=\"1-2-2\" data-name=\"record layout grid\">\n            <!-- ---------- LEFT SUMMARY RAIL ---------- -->\n            <aside class=\"rounded-xl border border-[var(--desk-line)] bg-white\" data-kid=\"1-2-2-1\" data-name=\"left summary rail card\">\n                <div class=\"px-4 pb-4 pt-4\" data-kid=\"1-2-2-1-1\" data-name=\"summarry rail header block\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1-1\" data-name=\"booking code and kind row\">\n                        <span class=\"mono text-[11.5px] font-medium text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"booking code text\">\n                            A00015\n                        </span>\n                        <span class=\"rounded border border-[var(--desk-line)] px-1.5 py-px text-[10px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"booking kind badge\">\n                            Desk\n                        </span>\n                    </div>\n                    <h1 class=\"mt-1.5 text-[19px] font-semibold leading-tight tracking-tight text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"hotel name heading\">\n                        Manarat ghaza hotel\n                    </h1>\n                    <dl class=\"mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-[13px]\" data-kid=\"1-2-2-1-1-3\" data-name=\"booking summary detail list\">\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"agency label\">\n                            Agency\n                        </dt>\n                        <dd class=\"truncate text-right font-medium text-[var(--desk-text)]\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"agency name value\">\n                            Mohamed Dellai\n                        </dd>\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-1-3-3\" data-name=\"guest label\">\n                            Guest\n                        </dt>\n                        <dd class=\"truncate text-right font-medium text-[var(--desk-text)]\" data-kid=\"1-2-2-1-1-3-4\" data-name=\"guest name value\">\n                            ahmed\n                        </dd>\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-1-3-5\" data-name=\"rep label\">\n                            Rep\n                        </dt>\n                        <dd class=\"text-right text-[var(--desk-muted-soft)]\" data-kid=\"1-2-2-1-1-3-6\" data-name=\"rep name placeholder\">\n                            —\n                        </dd>\n                    </dl>\n                </div>\n                <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-4\" data-kid=\"1-2-2-1-2\" data-name=\"dates section container\">\n                    <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-2-2-1-2-1\" data-name=\"check-in and check-out date grid\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"check-in date block\">\n                            <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"check-in label\">\n                                Check-in\n                            </p>\n                            <p class=\"mt-1 text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"check-in date value\">\n                                Sat 31 Oct 2026\n                            </p>\n                            <p class=\"mt-0.5 text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"check-in Arabic date\" dir=\"rtl\">\n                                20 جمادى الأولى 1448\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-2-1-2-1-2\" data-name=\"check-out date block\">\n                            <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"check-out label\">\n                                Check-out\n                            </p>\n                            <p class=\"mt-1 text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"check-out date value\">\n                                Sat 7 Nov 2026\n                            </p>\n                            <p class=\"mt-0.5 text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-1-2-3\" data-name=\"check-out Arabic date\" dir=\"rtl\">\n                                27 جمادى الأولى 1448\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"num mt-2.5 text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"stay summary line\">\n                        7 nights · 10 rooms · 3 lines\n                    </p>\n                </div>\n                <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-4\" data-kid=\"1-2-2-1-3\" data-name=\"lifecycle section\">\n                    <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-3-1\" data-name=\"lifecycle section label\">\n                        Lifecycle\n                    </p>\n                    <ol class=\"mt-2.5\" data-kid=\"1-2-2-1-3-2\" data-name=\"lifecycle timeline\">\n                        <li class=\"relative flex items-start gap-2.5 pb-3.5\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"completed request step\">\n                            <span class=\"absolute left-[8px] top-[18px] h-[calc(100%-6px)] w-px bg-[var(--desk-line-strong)]\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"step connector line\">\n                            </span>\n                            <span class=\"relative mt-0.5 flex size-[17px] shrink-0 items-center justify-center rounded-full bg-[var(--desk-ink)] text-[9px] text-white\" data-kid=\"1-2-2-1-3-2-1-2\" data-name=\"done step indicator\">\n                                <i class=\"icon-check\" data-kid=\"1-2-2-1-3-2-1-2-1\" data-name=\"check icon\">\n                                </i>\n                            </span>\n                            <span class=\"text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-3-2-1-3\" data-name=\"step label text\">\n                                Request\n                            </span>\n                        </li>\n                        <li class=\"relative flex items-center justify-between gap-2 pb-3.5\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"current provisional step\">\n                            <span class=\"absolute left-[8px] top-[18px] h-[calc(100%-6px)] w-px bg-[var(--desk-line-strong)]\" data-kid=\"1-2-2-1-3-2-2-1\" data-name=\"step connector line\">\n                            </span>\n                            <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-1-3-2-2-2\" data-name=\"current step indicator group\">\n                                <span class=\"relative flex size-[17px] shrink-0 items-center justify-center rounded-full border-2 border-[var(--desk-primary)] bg-white\" data-kid=\"1-2-2-1-3-2-2-2-1\" data-name=\"active step dot container\">\n                                    <span class=\"size-2 rounded-full bg-[var(--desk-primary)]\" data-kid=\"1-2-2-1-3-2-2-2-1-1\" data-name=\"active step inner dot\">\n                                    </span>\n                                </span>\n                                <span class=\"text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-3-2-2-2-2\" data-name=\"current step label\">\n                                    Provisional\n                                </span>\n                            </span>\n                            <span class=\"rounded-full bg-[var(--desk-primary-soft)] px-2 py-0.5 text-[11px] font-semibold text-[var(--desk-primary-deep)]\" data-kid=\"1-2-2-1-3-2-2-3\" data-name=\"current status badge\">\n                                Current\n                            </span>\n                        </li>\n                        <li class=\"flex items-center gap-2.5\" data-kid=\"1-2-2-1-3-2-3\" data-name=\"pending confirmed step\">\n                            <span class=\"flex size-[17px] shrink-0 items-center justify-center rounded-full border-[1.5px] border-[var(--desk-line-strong)] bg-white\" data-kid=\"1-2-2-1-3-2-3-1\" data-name=\"empty step dot\">\n                            </span>\n                            <span class=\"text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-3-2-3-2\" data-name=\"step label text\">\n                                Confirmed\n                            </span>\n                        </li>\n                    </ol>\n                </div>\n                <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-4\" data-kid=\"1-2-2-1-4\" data-name=\"hold expiry section\">\n                    <div class=\"rounded-lg border border-[var(--desk-warning-line)] bg-[var(--desk-warning-soft)] p-3\" data-kid=\"1-2-2-1-4-1\" data-name=\"hold expiry warning card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"warning header row\">\n                            <div data-kid=\"1-2-2-1-4-1-1-1\" data-name=\"expiry details block\">\n                                <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-warning-ink)]\" data-kid=\"1-2-2-1-4-1-1-1-1\" data-name=\"expiry label\">\n                                    Hold expires\n                                </p>\n                                <p class=\"num mt-1 text-[13.5px] font-semibold text-[var(--desk-warning-ink)]\" data-kid=\"1-2-2-1-4-1-1-1-2\" data-name=\"expiry date time\">\n                                    Fri 16 Oct · 02:52\n                                </p>\n                            </div>\n                            <span class=\"num shrink-0 rounded-md border border-[var(--desk-warning-line)] bg-white px-2 py-1 text-[11.5px] font-semibold text-[var(--desk-warning-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-1-1-2\" data-name=\"hold countdown badge\" data-reason=\"time remaining recomputed by countdown script\">\n                                1d 6h\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[12px] leading-[17px] text-[var(--desk-warning-ink)]\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"warning action message\">\n                            Confirm before the hold lapses to keep these rooms.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-4\" data-kid=\"1-2-2-1-5\" data-name=\"supplier status section\">\n                    <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-5-1\" data-name=\"supplier section label\">\n                        Supplier\n                    </p>\n                    <div class=\"mt-1.5 flex items-center justify-between gap-3\" data-kid=\"1-2-2-1-5-2\" data-name=\"supplier status row\">\n                        <span class=\"flex items-center gap-2 text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-5-2-1\" data-name=\"supplier status indicator\">\n                            <span class=\"size-2 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-2-2-1-5-2-1-1\" data-name=\"status dot\">\n                            </span>\n                            Waiting\n                        </span>\n                        <span class=\"num text-[12px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-5-2-2\" data-name=\"supplier progress text\">\n                            1 of 3 lines confirmed\n                        </span>\n                    </div>\n                </div>\n                <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-4\" data-kid=\"1-2-2-1-6\" data-name=\"money section\">\n                    <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-6-1\" data-name=\"money section label\">\n                        Money\n                    </p>\n                    <dl class=\"num mt-2 grid grid-cols-2 gap-x-3 gap-y-2 text-[13px]\" data-kid=\"1-2-2-1-6-2\" data-name=\"money detail list\">\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-6-2-1\" data-name=\"booking total label\">\n                            Booking total\n                        </dt>\n                        <dd class=\"text-right font-medium text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-6-2-2\" data-name=\"booking total value\">\n                            SAR 20,020\n                        </dd>\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-6-2-3\" data-name=\"paid label\">\n                            Paid\n                        </dt>\n                        <dd class=\"text-right font-medium text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-6-2-4\" data-name=\"paid value\">\n                            SAR 12,510\n                        </dd>\n                        <dt class=\"text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-6-2-5\" data-name=\"unposted label\">\n                            Unposted\n                        </dt>\n                        <dd class=\"text-right font-medium text-[var(--desk-warning-ink)]\" data-kid=\"1-2-2-1-6-2-6\" data-name=\"unposted value\">\n                            SAR 2,500\n                        </dd>\n                    </dl>\n                    <div class=\"num mt-3 flex items-center justify-between border-t border-[var(--desk-line-soft)] pt-2.5\" data-kid=\"1-2-2-1-6-3\" data-name=\"left to pay row\">\n                        <span class=\"text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-6-3-1\" data-name=\"left to pay label\">\n                            Left to pay\n                        </span>\n                        <span class=\"text-[15px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-6-3-2\" data-name=\"left to pay value\">\n                            SAR 7,510\n                        </span>\n                    </div>\n                    <p class=\"mt-1.5 text-[11.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-6-4\" data-name=\"money note\">\n                        Room prices are per room-night.\n                    </p>\n                </div>\n                <!-- actions (menu anchors here) -->\n                <div class=\"relative border-t border-[var(--desk-line)] bg-[var(--desk-canvas)] p-4\" data-kid=\"1-2-2-1-7\" data-name=\"actions section\">\n                    <!-- OPEN MENU: paints above the scrim -->\n                    <div class=\"absolute bottom-full left-4 right-4 z-40 mb-2 overflow-hidden rounded-xl border border-[var(--desk-line)] bg-white menu-shadow\" data-kid=\"1-2-2-1-7-1\" data-name=\"change-or-end booking menu\">\n                        <p class=\"border-b border-[var(--desk-line-soft)] px-3 py-2 text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-1-1\" data-name=\"menu title\">\n                            Change or end booking\n                        </p>\n                        <button class=\"flex w-full items-center gap-2.5 px-3 py-2.5 text-left text-[13px] font-medium text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-7-1-2\" data-name=\"back to request menu item\">\n                            <i class=\"icon-arrow-left-right w-4 shrink-0 text-center text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-1-2-1\" data-name=\"arrow left-right icon\">\n                            </i>\n                            Back to request\n                        </button>\n                        <button class=\"flex w-full items-center gap-2.5 px-3 py-2.5 text-left text-[13px] font-medium text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-7-1-3\" data-name=\"cannot provide menu item\">\n                            <i class=\"icon-circle-slash w-4 shrink-0 text-center text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-1-3-1\" data-name=\"circle slash icon\">\n                            </i>\n                            Cannot provide\n                        </button>\n                        <button class=\"flex w-full items-center gap-2.5 bg-[var(--desk-danger-soft)] px-3 py-2.5 text-left text-[13px] font-semibold text-[var(--desk-danger-ink)]\" data-kid=\"1-2-2-1-7-1-4\" data-name=\"cancel reservation menu item\">\n                            <i class=\"icon-ban w-4 shrink-0 text-center text-[13px]\" data-kid=\"1-2-2-1-7-1-4-1\" data-name=\"ban icon\">\n                            </i>\n                            Cancel reservation\n                        </button>\n                        <p class=\"border-t border-[var(--desk-line-soft)] px-3 py-2 text-[11.5px] leading-[15px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-1-5\" data-name=\"menu footnote\">\n                            Every option here can free held rooms. Each one asks first.\n                        </p>\n                    </div>\n                    <button class=\"flex h-10 w-full items-center justify-center gap-2 rounded-full bg-[var(--desk-primary)] text-[13px] font-semibold text-white\" data-kid=\"1-2-2-1-7-2\" data-name=\"confirm reservation button\">\n                        <i class=\"icon-circle-check text-[15px]\" data-kid=\"1-2-2-1-7-2-1\" data-name=\"circle check icon\">\n                        </i>\n                        Confirm reservation\n                    </button>\n                    <p class=\"mt-1.5 text-[11.5px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-3\" data-name=\"confirm button helper\">\n                        Releases the hold and locks all 10 rooms.\n                    </p>\n                    <button class=\"mt-3 flex h-9 w-full items-center justify-center gap-2 rounded-lg border border-[var(--desk-line)] bg-white text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-7-4\" data-name=\"edit booking button\">\n                        <i class=\"icon-pencil text-[14px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-4-1\" data-name=\"pencil icon\">\n                        </i>\n                        Edit booking details\n                    </button>\n                    <p class=\"mt-1.5 text-[11.5px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-5\" data-name=\"edit button helper\">\n                        Agency, guest, dates, hotel confirmation.\n                    </p>\n                    <button aria-expanded=\"true\" class=\"mt-3 flex h-9 w-full items-center justify-between rounded-lg border border-[var(--desk-primary)] bg-white px-3 text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-1-7-6\" data-name=\"change or end booking button\">\n                        Change or end booking\n                        <i class=\"icon-chevron-up text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-6-1\" data-name=\"chevron up icon\">\n                        </i>\n                    </button>\n                    <p class=\"mt-1.5 text-[11.5px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-7-7\" data-name=\"change button helper\">\n                        Reversing and destructive transitions.\n                    </p>\n                </div>\n            </aside>\n            <!-- ---------- WORKSPACE ---------- -->\n            <section class=\"min-w-0\" data-kid=\"1-2-2-2\" data-name=\"workspace section\">\n               