      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n@layer base {\n  :root {\n    --desk-canvas:#f8fafc; --desk-surface:#ffffff; --desk-surface-muted:#f1f5f9;\n    --desk-ink:#15375e; --desk-text:#414649; --desk-text-soft:#64748b; --desk-muted:#64748b; --desk-muted-soft:#94a3b8;\n    --desk-primary:#2d60e0; --desk-primary-hover:#1d4ed8; --desk-primary-deep:#0046c3; --desk-primary-soft:#eff6ff; --desk-info-line:#bfdbfe;\n    --desk-line:#e2e8f0; --desk-line-soft:#f1f5f9; --desk-line-strong:#cbd5e1;\n    --desk-gold:#c59b27; --desk-gold-soft:#fffbeb;\n    --desk-success-ink:#047857; --desk-success-soft:#ecfdf5; --desk-success-line:#a7f3d0;\n    --desk-warning-ink:#b45309; --desk-warning-soft:#fffbeb; --desk-warning-line:#fde68a;\n    --desk-danger-ink:#b91c1c; --desk-danger-soft:#fef2f2; --desk-danger-line:#fecaca;\n  }\n  body { font-family:'Plus Jakarta Sans',sans-serif; background:var(--desk-canvas); color:var(--desk-text); }\n}\n.tnum { font-variant-numeric: tabular-nums; }\n.mono { font-family:'IBM Plex Mono',monospace; }\n@layer components {\n  .dfield { min-height:2.25rem; width:100%; border:1px solid var(--desk-line); border-radius:.5rem; background:#fff; padding:.4rem .625rem; color:var(--desk-ink); font-size:.875rem; line-height:1.2rem; }\n  .dfield:focus { border-color:var(--desk-primary); outline:2px solid var(--desk-primary); outline-offset:2px; }\n  .dfield:disabled { background:var(--desk-surface-muted); color:var(--desk-text-soft); }\n}\n.cbx { appearance:none; width:1.05rem; height:1.05rem; border:1.5px solid var(--desk-line-strong); border-radius:.3rem; background:#fff; display:inline-grid; place-content:center; cursor:pointer; }\n.cbx:checked { background:var(--desk-primary); border-color:var(--desk-primary); }\n.cbx:checked::after { content:''; width:.55rem; height:.55rem; background:#fff; clip-path:polygon(14% 44%,0 60%,40% 100%,100% 20%,84% 4%,40% 68%); }\n.lrow:hover { background:var(--desk-canvas); }\n/* unlayered on purpose: must beat the px-3 utilities to keep the grid inside 1440 */\n.lines-table td, .lines-table th { padding-inline:.55rem; }\n.lines-table td:last-child, .lines-table th:last-child { padding-right:.35rem; }\n.lines-table .subline { font-size:11.5px; }\n</style>\n<div class=\"min-h-screen bg-[var(--desk-canvas)] text-[13.5px] text-[var(--desk-text)] antialiased\" data-kid=\"1\">\n    <div class=\"flex items-start\" data-kid=\"1-1\">\n        <!-- ============ APP ICON RAIL ============ -->\n        <aside class=\"sticky top-0 z-40 flex h-screen w-16 shrink-0 flex-col items-center border-e border-[var(--desk-line)] bg-white py-3\" data-kid=\"1-1-1\">\n            <div class=\"grid size-9 place-items-center rounded-lg bg-[var(--desk-ink)] text-white\" data-kid=\"1-1-1-1\">\n                <i aria-hidden=\"true\" class=\"icon-bird text-[17px]\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </div>\n            <nav aria-label=\"Falco sections\" class=\"mt-5 flex flex-col items-center gap-1.5\" data-kid=\"1-1-1-2\">\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-1\" title=\"Dashboard\">\n                    <i aria-hidden=\"true\" class=\"icon-layout-dashboard text-[18px]\" data-kid=\"1-1-1-2-1-1\">\n                    </i>\n                </button>\n                <button aria-current=\"page\" class=\"relative grid size-10 place-items-center rounded-lg bg-[var(--desk-primary-soft)] text-[var(--desk-primary)]\" data-kid=\"1-1-1-2-2\" title=\"Reservations\">\n                    <i aria-hidden=\"true\" class=\"icon-bed-double text-[18px]\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                    <span class=\"absolute end-1.5 top-1.5 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-1-1-2-2-2\">\n                    </span>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-3\" title=\"Reports\">\n                    <i aria-hidden=\"true\" class=\"icon-bar-chart-3 text-[18px]\" data-kid=\"1-1-1-2-3-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-4\" title=\"Hotels\">\n                    <i aria-hidden=\"true\" class=\"icon-building-2 text-[18px]\" data-kid=\"1-1-1-2-4-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-5\" title=\"Contracts\">\n                    <i aria-hidden=\"true\" class=\"icon-layers-3 text-[18px]\" data-kid=\"1-1-1-2-5-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-6\" title=\"Room types\">\n                    <i aria-hidden=\"true\" class=\"icon-clipboard-list text-[18px]\" data-kid=\"1-1-1-2-6-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-7\" title=\"Agencies\">\n                    <i aria-hidden=\"true\" class=\"icon-users text-[18px]\" data-kid=\"1-1-1-2-7-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-8\" title=\"Availability\">\n                    <i aria-hidden=\"true\" class=\"icon-circle-check text-[18px]\" data-kid=\"1-1-1-2-8-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-9\" title=\"Documents\">\n                    <i aria-hidden=\"true\" class=\"icon-folder-open text-[18px]\" data-kid=\"1-1-1-2-9-1\">\n                    </i>\n                </button>\n                <button class=\"grid size-10 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-1-2-10\" title=\"Settings\">\n                    <i aria-hidden=\"true\" class=\"icon-settings text-[18px]\" data-kid=\"1-1-1-2-10-1\">\n                    </i>\n                </button>\n            </nav>\n            <div class=\"mt-auto grid size-8 place-items-center rounded-full bg-[var(--desk-ink)] text-[11px] font-bold text-white\" data-kid=\"1-1-1-3\">\n                N\n            </div>\n        </aside>\n        <!-- ============ MAIN COLUMN ============ -->\n        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2\">\n            <!-- Top bar -->\n            <header class=\"sticky top-0 z-30 flex h-14 items-center gap-4 border-b border-[var(--desk-line)] bg-white px-6\" data-kid=\"1-1-2-1\">\n                <div class=\"flex min-w-0 items-baseline gap-2\" data-kid=\"1-1-2-1-1\">\n                    <span class=\"text-[14px] font-semibold tracking-tight text-[var(--desk-ink)]\" data-kid=\"1-1-2-1-1-1\">\n                        A00015\n                    </span>\n                    <span class=\"text-[13px] text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-1-1-2\">\n                        /\n                    </span>\n                    <a class=\"text-[13px] font-medium text-[var(--desk-muted)] hover:text-[var(--desk-ink)]\" data-kid=\"1-1-2-1-1-3\" href=\"#\">\n                        Reservations\n                    </a>\n                </div>\n                <div class=\"ms-auto flex items-center gap-3\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"relative\" data-kid=\"1-1-2-1-2-1\">\n                        <i aria-hidden=\"true\" class=\"icon-search pointer-events-none absolute start-2.5 top-1/2 -translate-y-1/2 text-[15px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-1-2-1-1\">\n                        </i>\n                        <input aria-label=\"Search hotels and reservations\" class=\"dfield w-60 ps-8\" data-kid=\"1-1-2-1-2-1-2\" placeholder=\"Search reservations\" type=\"search\"/>\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-lg border border-[var(--desk-line)] px-2.5 py-1.5\" data-kid=\"1-1-2-1-2-2\">\n                        <span class=\"text-[11.5px] font-bold uppercase tracking-[0.06em] text-[var(--desk-gold)]\" data-kid=\"1-1-2-1-2-2-1\">\n                            SAR / USD\n                        </span>\n                        <span class=\"tnum text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-1-2-2-2\">\n                            3.7500\n                        </span>\n                    </div>\n                    <button aria-label=\"Notifications\" class=\"relative grid size-9 place-items-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-2-1-2-3\">\n                        <i aria-hidden=\"true\" class=\"icon-bell text-[17px]\" data-kid=\"1-1-2-1-2-3-1\">\n                        </i>\n                        <span class=\"absolute end-2 top-2 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-1-2-1-2-3-2\">\n                        </span>\n                    </button>\n                    <div class=\"grid size-8 place-items-center rounded-full bg-[var(--desk-ink)] text-[11px] font-bold text-white\" data-kid=\"1-1-2-1-2-4\">\n                        MD\n                    </div>\n                </div>\n            </header>\n            <div class=\"mx-auto grid max-w-[1600px] grid-cols-[320px_minmax(0,1fr)] items-start gap-5 px-6 py-5\" data-kid=\"1-1-2-2\">\n                <!-- ============ SUMMARY RAIL ============ -->\n                <aside class=\"sticky top-[76px] rounded-xl border border-[var(--desk-line)] bg-white\" data-kid=\"1-1-2-2-1\">\n                    <!-- 1 · identity -->\n                    <div class=\"px-4 pb-3.5 pt-4\" data-kid=\"1-1-2-2-1-1\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-1-1-1\">\n                            <span class=\"mono text-[12px] font-medium text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                A00015\n                            </span>\n                            <span class=\"rounded border border-[var(--desk-line)] bg-[var(--desk-surface-muted)] px-1.5 py-px text-[10px] font-bold uppercase tracking-[0.06em] text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-1-1-1-2\">\n                                Desk\n                            </span>\n                        </div>\n                        <h1 class=\"mt-1.5 text-[19px] font-semibold leading-[1.2] tracking-tight text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-1-2\">\n                            Manarat ghaza hotel\n                        </h1>\n                        <dl class=\"mt-3 grid grid-cols-[64px_minmax(0,1fr)] gap-x-3 gap-y-1.5\" data-kid=\"1-1-2-2-1-1-3\">\n                            <dt class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-1-3-1\">\n                                Agency\n                            </dt>\n                            <dd class=\"truncate text-[13.5px] font-medium text-[var(--desk-text)]\" data-kid=\"1-1-2-2-1-1-3-2\">\n                                Mohamed Dellai\n                            </dd>\n                            <dt class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-1-3-3\">\n                                Guest\n                            </dt>\n                            <dd class=\"truncate text-[13.5px] font-medium text-[var(--desk-text)]\" data-kid=\"1-1-2-2-1-1-3-4\">\n                                ahmed\n                            </dd>\n                            <dt class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-1-3-5\">\n                                Rep\n                            </dt>\n                            <dd class=\"text-[13.5px] text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-2-1-1-3-6\">\n                                —\n                            </dd>\n                        </dl>\n                    </div>\n                    <!-- 2 · stay -->\n                    <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-3.5\" data-kid=\"1-1-2-2-1-2\">\n                        <div class=\"grid grid-cols-[minmax(0,1fr)_14px_minmax(0,1fr)] items-start gap-1\" data-kid=\"1-1-2-2-1-2-1\">\n                            <div class=\"min-w-0\" data-kid=\"1-1-2-2-1-2-1-1\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-2-1-1-1\">\n                                    Check-in\n                                </span>\n                                <p class=\"tnum mt-0.5 text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-2-1-1-2\">\n                                    Sat 31 Oct 2026\n                                </p>\n                                <p class=\"mt-px text-[11px] leading-[1.05rem] text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-1-2-1-1-3\" dir=\"rtl\">\n                                    20 جمادى الأولى\n                                    <br data-kid=\"1-1-2-2-1-2-1-1-3-1\"/>\n                                    1448\n                                </p>\n                            </div>\n                            <div class=\"pt-[26px] text-center text-[var(--desk-line-strong)]\" data-kid=\"1-1-2-2-1-2-1-2\">\n                                <i aria-hidden=\"true\" class=\"icon-arrow-right text-[12px]\" data-kid=\"1-1-2-2-1-2-1-2-1\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0\" data-kid=\"1-1-2-2-1-2-1-3\">\n                                <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-2-1-3-1\">\n                                    Check-out\n                                </span>\n                                <p class=\"tnum mt-0.5 text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-2-1-3-2\">\n                                    Sat 7 Nov 2026\n                                </p>\n                                <p class=\"mt-px text-[11px] leading-[1.05rem] text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-1-2-1-3-3\" dir=\"rtl\">\n                                    27 جمادى الأولى\n                                    <br data-kid=\"1-1-2-2-1-2-1-3-3-1\"/>\n                                    1448\n                                </p>\n                            </div>\n                        </div>\n                        <p class=\"tnum mt-2 text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-2-2\">\n                            7 nights · 10 rooms · Hotel direct\n                        </p>\n                    </div>\n                    <!-- 3 · lifecycle -->\n                    <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-3.5\" data-kid=\"1-1-2-2-1-3\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-3-1\">\n                            Booking stage\n                        </span>\n                        <ol class=\"mt-2.5\" data-kid=\"1-1-2-2-1-3-2\">\n                            <li class=\"relative flex items-center gap-2.5 pb-3\" data-kid=\"1-1-2-2-1-3-2-1\">\n                                <span aria-hidden=\"true\" class=\"absolute start-[6.5px] top-[15px] h-full w-px bg-[var(--desk-line)]\" data-kid=\"1-1-2-2-1-3-2-1-1\">\n                                </span>\n                                <span class=\"relative grid size-[15px] shrink-0 place-items-center rounded-full bg-[var(--desk-ink)] text-white\" data-kid=\"1-1-2-2-1-3-2-1-2\">\n                                    <i aria-hidden=\"true\" class=\"icon-check text-[10px] font-bold\" data-kid=\"1-1-2-2-1-3-2-1-2-1\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[13px] font-medium text-[var(--desk-text-soft)]\" data-kid=\"1-1-2-2-1-3-2-1-3\">\n                                    Request\n                                </span>\n                                <span class=\"ms-auto text-[11.5px] text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-2-1-3-2-1-4\">\n                                    14 Oct\n                                </span>\n                            </li>\n                            <li class=\"relative flex items-center gap-2.5 pb-3\" data-kid=\"1-1-2-2-1-3-2-2\">\n                                <span aria-hidden=\"true\" class=\"absolute start-[6.5px] top-[17px] h-full w-px bg-[var(--desk-line)]\" data-kid=\"1-1-2-2-1-3-2-2-1\">\n                                </span>\n                                <span class=\"relative grid size-[15px] shrink-0 place-items-center rounded-full border-[3px] border-[var(--desk-primary)] bg-white\" data-kid=\"1-1-2-2-1-3-2-2-2\">\n                                </span>\n                                <span class=\"text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-3-2-2-3\">\n                                    Provisional\n                                </span>\n                                <span class=\"ms-auto rounded-full bg-[var(--desk-primary-soft)] px-2 py-0.5 text-[11px] font-semibold text-[var(--desk-primary-deep)]\" data-kid=\"1-1-2-2-1-3-2-2-4\">\n                                    Current\n                                </span>\n                            </li>\n                            <li class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-2-1-3-2-3\">\n                                <span class=\"grid size-[13px] shrink-0 place-items-center rounded-full border border-[var(--desk-line-strong)] bg-white\" data-kid=\"1-1-2-2-1-3-2-3-1\">\n                                </span>\n                                <span class=\"text-[13px] font-medium text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-3-2-3-2\">\n                                    Confirmed\n                                </span>\n                            </li>\n                        </ol>\n                    </div>\n                    <!-- 4 · hold -->\n                    <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-3.5\" data-kid=\"1-1-2-2-1-4\">\n                        <div class=\"rounded-lg border border-[var(--desk-warning-line)] bg-[var(--desk-warning-soft)] px-3 py-2.5\" data-kid=\"1-1-2-2-1-4-1\">\n                            <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-1-2-2-1-4-1-1\">\n                                <span class=\"text-[11px] font-bold uppercase tracking-[0.05em] text-[var(--desk-warning-ink)]\" data-kid=\"1-1-2-2-1-4-1-1-1\">\n                                    Hold expires\n                                </span>\n                                <span class=\"tnum rounded border border-[var(--desk-warning-line)] bg-white px-1.5 py-0.5 text-[11.5px] font-semibold text-[var(--desk-warning-ink)]\" data-kid=\"1-1-2-2-1-4-1-1-2\">\n                                    17 h 11 m left\n                                </span>\n                            </div>\n                            <p class=\"tnum mt-1 text-[13.5px] font-semibold text-[var(--desk-warning-ink)]\" data-kid=\"1-1-2-2-1-4-1-2\">\n                                Fri 16 Oct · 02:52\n                            </p>\n                            <p class=\"mt-1 text-[12px] leading-[1.35rem] text-[var(--desk-warning-ink)]/90\" data-kid=\"1-1-2-2-1-4-1-3\">\n                                Confirm before the hold lapses to keep these rooms.\n                            </p>\n                        </div>\n                    </div>\n                    <!-- 5 · supplier -->\n                    <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-3.5\" data-kid=\"1-1-2-2-1-5\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-5-1\">\n                            Supplier\n                        </span>\n                        <div class=\"mt-1.5 flex items-center gap-2\" data-kid=\"1-1-2-2-1-5-2\">\n                            <span class=\"size-2 shrink-0 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-1-2-2-1-5-2-1\">\n                            </span>\n                            <span class=\"text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-5-2-2\">\n                                Waiting\n                            </span>\n                            <span class=\"tnum ms-auto text-[12px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-5-2-3\">\n                                1 of 3 lines confirmed\n                            </span>\n                        </div>\n                    </div>\n                    <!-- 6 · money -->\n                    <div class=\"border-t border-[var(--desk-line-soft)] px-4 py-3.5\" data-kid=\"1-1-2-2-1-6\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.05em] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-6-1\">\n                            Money\n                        </span>\n                        <dl class=\"tnum mt-2 grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1.5\" data-kid=\"1-1-2-2-1-6-2\">\n                            <dt class=\"text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-6-2-1\">\n                                Booking total\n                            </dt>\n                            <dd class=\"text-right text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-6-2-2\">\n                                SAR 20,020\n                            </dd>\n                            <dt class=\"text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-6-2-3\">\n                                Paid\n                            </dt>\n                            <dd class=\"text-right text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-6-2-4\">\n                                SAR 12,510\n                            </dd>\n                            <dt class=\"text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-1-6-2-5\">\n                                Unposted\n                            </dt>\n                            <dd class=\"text-right text-[13px] font-semibold text-[var(--desk-warning-ink)]\" data-kid=\"1-1-2-2-1-6-2-6\">\n                                SAR 2,500\n                            </dd>\n                        </dl>\n                        <div class=\"mt-2.5 flex items-center justify-between gap-3 border-t border-[var(--desk-line-soft)] pt-2.5\" data-kid=\"1-1-2-2-1-6-3\">\n                            <span class=\"text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-1-6-3-1\">\n                                Left to pay\n                            </span>\n                            <span class=\"tnum text-[15px] font-semibold text-[var(--desk-ink)]\" data-