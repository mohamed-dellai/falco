--desk-line)] bg-white\" data-kid=\"1-2-2-2-2\" data-name=\"room lines card\">\n                    <header class=\"flex items-center justify-between gap-4 px-5 py-4\" data-kid=\"1-2-2-2-2-1\" data-name=\"card header\">\n                        <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"card title group\">\n                            <h2 class=\"text-[15px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"rooms table heading\">\n                                Room lines\n                            </h2>\n                            <p class=\"num text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"line summary text\">\n                                3 lines · 10 rooms · 7 nights\n                            </p>\n                        </div>\n                        <button class=\"flex h-9 items-center gap-1.5 rounded-lg border border-[var(--desk-line)] bg-white px-3 text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"add a room button\">\n                            <i class=\"icon-plus text-[14px]\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"plus icon\">\n                            </i>\n                            Add a room\n                        </button>\n                    </header>\n                    <div class=\"mx-5 mb-4 flex items-center justify-between gap-4 rounded-lg border border-[var(--desk-info-line)] bg-[var(--desk-primary-soft)] px-3.5 py-2.5\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2\" data-name=\"bulk selection toolbar\" data-reason=\"selected-count and toolbar visibility driven by row selection state via script\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"bulk toolbar left group\">\n                            <span class=\"num text-[13px] font-semibold text-[var(--desk-primary-deep)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"selected-count indicator\" data-reason=\"count text updated as rows are selected via script\">\n                                2 lines selected\n                            </span>\n                            <span class=\"text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"send to hotel label\">\n                                Send to hotel:\n                            </span>\n                            <span class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-2-2-2-1-3\" data-name=\"bulk action buttons wrapper\">\n                                <button class=\"h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-2-1-3-1\" data-name=\"request bulk action button\">\n                                    Request\n                                </button>\n                                <button class=\"h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-2-1-3-2\" data-name=\"amendment bulk action button\">\n                                    Amendment\n                                </button>\n                                <button class=\"h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-2-1-3-3\" data-name=\"voucher bulk action button\">\n                                    Voucher\n                                </button>\n                                <button class=\"h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-danger-ink)]\" data-kid=\"1-2-2-2-2-2-1-3-4\" data-name=\"cancel bulk action button\">\n                                    Cancel\n                                </button>\n                            </span>\n                        </div>\n                        <button class=\"sh