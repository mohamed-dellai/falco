    "var_64cac822d8b0": {
      "type": "variant",
      "label": "2 · Reservation — Payments",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  @layer base {\n    :root {\n      --desk-canvas: #f8fafc;\n      --desk-surface: #ffffff;\n      --desk-surface-muted: #f1f5f9;\n      --desk-ink: #15375e;\n      --desk-text: #414649;\n      --desk-text-soft: #64748b;\n      --desk-muted: #64748b;\n      --desk-muted-soft: #94a3b8;\n      --desk-primary: #2d60e0;\n      --desk-primary-hover: #1d4ed8;\n      --desk-primary-deep: #0046c3;\n      --desk-primary-soft: #eff6ff;\n      --desk-info-line: #bfdbfe;\n      --desk-line: #e2e8f0;\n      --desk-line-soft: #f1f5f9;\n      --desk-line-strong: #cbd5e1;\n      --desk-gold: #c59b27;\n      --desk-success: #047857;\n      --desk-success-soft: #ecfdf5;\n      --desk-success-line: #a7f3d0;\n      --desk-warning: #b45309;\n      --desk-warning-soft: #fffbeb;\n      --desk-warning-line: #fde68a;\n      --desk-danger: #b91c1c;\n      --desk-danger-soft: #fef2f2;\n      --desk-danger-line: #fecaca;\n      --desk-control-height: 2.25rem;\n    }\n    body {\n      font-family: \"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif;\n      background: var(--desk-canvas);\n      color: var(--desk-text);\n      -webkit-font-smoothing: antialiased;\n    }\n  }\n\n  @layer components {\n    .mono { font-family: \"IBM Plex Mono\", ui-monospace, monospace; }\n    .num { font-variant-numeric: tabular-nums; }\n    .field {\n      min-height: var(--desk-control-height);\n      width: 100%;\n      border: 1px solid var(--desk-line);\n      border-radius: 0.5rem;\n      background: var(--desk-surface);\n      padding: 0.5rem 0.75rem;\n      color: var(--desk-ink);\n      font-size: 0.875rem;\n      line-height: 1.25rem;\n    }\n    .field:focus-visible { outline: 2px solid var(--desk-primary); outline-offset: 2px; }\n    .flabel {\n      font-size: 0.75rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      color: var(--desk-muted);\n    }\n    .btn-primary {\n      display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;\n      height: 2.25rem; padding: 0 1rem; border-radius: 9999px;\n      background: var(--desk-primary); color: #ffffff;\n      font-size: 0.8125rem; font-weight: 600;\n      transition: background-color 140ms ease;\n    }\n    .btn-primary:hover { background: var(--desk-primary-hover); }\n    .btn-secondary {\n      display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;\n      min-height: 2rem; padding: 0 0.75rem; border-radius: 0.5rem;\n      border: 1px solid var(--desk-line); background: #ffffff;\n      color: var(--desk-ink); font-size: 0.8125rem; font-weight: 600;\n      transition: background-color 140ms ease;\n    }\n    .btn-secondary:hover { background: var(--desk-surface-muted); }\n    .btn-quiet {\n      display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;\n      min-height: 2rem; padding: 0 0.625rem; border-radius: 0.5rem;\n      color: var(--desk-muted); font-size: 0.8125rem; font-weight: 600;\n    }\n    .btn-quiet:hover { background: var(--desk-surface-muted); color: var(--desk-ink); }\n    .btn-danger-text {\n      display: inline-flex; align-items: center; gap: 0.375rem;\n      min-height: 2rem; padding: 0 0.5rem; border-radius: 0.5rem;\n      color: var(--desk-danger); font-size: 0.8125rem; font-weight: 600;\n    }\n    .btn-danger-text:hover { background: var(--desk-danger-soft); }\n    .th {\n      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em;\n      text-transform: uppercase; color: var(--desk-muted);\n    }\n    .rail-label {\n      font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.05em;\n      text-transform: uppercase; color: var(--desk-muted);\n    }\n  }\n</style>\n<div class=\"flex min-h-screen items-start\" data-kid=\"1\">\n    <!-- ============ APP ICON RAIL ============ -->\n    <aside class=\"sticky top-0 flex h-screen w-16 shrink-0 flex-col items-center gap-1 border-r border-[var(--desk-line)] bg-white py-3\" data-kid=\"1-1\">\n        <div class=\"mb-3 flex size-9 items-center justify-center rounded-lg bg-[var(--desk-ink)] text-white\" data-kid=\"1-1-1\">\n            <i aria-hidden=\"true\" class=\"icon-send text-[15px]\" data-kid=\"1-1-1-1\">\n            </i>\n        </div>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-2\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-layout-dashboard text-[17px]\" data-kid=\"1-1-2-1\">\n            </i>\n        </a>\n        <a aria-current=\"page\" class=\"relative flex size-9 items-center justify-center rounded-lg bg-[var(--desk-primary-soft)] text-[var(--desk-primary)]\" data-kid=\"1-1-3\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-bed-double text-[17px]\" data-kid=\"1-1-3-1\">\n            </i>\n            <span class=\"absolute right-1 top-1 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-1-3-2\">\n            </span>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-4\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-bar-chart-3 text-[17px]\" data-kid=\"1-1-4-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-5\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-building-2 text-[17px]\" data-kid=\"1-1-5-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-6\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-layers-3 text-[17px]\" data-kid=\"1-1-6-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-7\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-clipboard-list text-[17px]\" data-kid=\"1-1-7-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-8\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-users text-[17px]\" data-kid=\"1-1-8-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-9\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-circle-check text-[17px]\" data-kid=\"1-1-9-1\">\n            </i>\n        </a>\n        <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-10\" href=\"#\">\n            <i aria-hidden=\"true\" class=\"icon-folder-open text-[17px]\" data-kid=\"1-1-10-1\">\n            </i>\n        </a>\n        <div class=\"mt-auto\" data-kid=\"1-1-11\">\n            <a class=\"flex size-9 items-center justify-center rounded-lg text-[var(--desk-muted)] hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-11-1\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon-settings text-[17px]\" data-kid=\"1-1-11-1-1\">\n                </i>\n            </a>\n        </div>\n    </aside>\n    <div class=\"min-w-0 flex-1\" data-kid=\"1-2\">\n        <!-- ============ TOP BAR ============ -->\n        <header class=\"sticky top-0 z-30 flex h-14 items-center gap-4 border-b border-[var(--desk-line)] bg-white px-6\" data-kid=\"1-2-1\">\n            <div class=\"flex min-w-0 items-baselin