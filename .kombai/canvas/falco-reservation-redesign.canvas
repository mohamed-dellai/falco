       <span class=\"pointer-events-none absolute end-2 top-1/2 -translate-y-1/2 text-[11px] font-semibold text-[var(--desk-muted-soft)]\" data-kid=\"1-1-2-2-2-2-3-1-2-4-6-2-2\">\n                                                    SAR\n                                                </span>\n                                            </div>\n                                        </td>\n                                        <td class=\"px-3 py-3 text-right align-top\" data-kid=\"1-1-2-2-2-2-3-1-2-4-7\">\n                                            <span class=\"tnum text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-1-2-2-2-2-3-1-2-4-7-1\">\n                                                2,940\n                                            </span>\n                                            <p class=\"mt-0.5 text-[11px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-3-1-2-4-7-2\">\n                                                2 × 7 nights\n                                            </p>\n                                        </td>\n                                        <td class=\"px-3 py-3 text-right align-top\" data-kid=\"1-1-2-2-2-2-3-1-2-4-8\">\n                                            <button aria-label=\"Discard new line\" class=\"grid size-8 place-items-center rounded-md text-[var(--desk-muted)] hover:bg-white\" data-kid=\"1-1-2-2-2-2-3-1-2-4-8-1\">\n                                                <i aria-hidden=\"true\" class=\"icon-x text-[14px]\" data-kid=\"1-1-2-2-2-2-3-1-2-4-8-1-1\">\n                                                </i>\n                                            </button>\n                                        </td>\n                                    </tr>\n                                    <!-- edit action row -->\n                                    <tr class=\"bg-[var(--desk-canvas)]\" data-kid=\"1-1-2-2-2-2-3-1-2-5\">\n                                        <td class=\"px-3 py-2.5\" colspan=