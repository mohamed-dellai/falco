 cell\">\n                                    6\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-2-1-5\" data-name=\"double cost cell\">\n                                    190.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-1-6\" data-name=\"double sell cell\">\n                                    250.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-1-7\" data-name=\"double amount cell\">\n                                    10,500\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3 text-right text-[13px] text-[var(--desk-muted-soft)]\" data-kid=\"1-2-2-2-2-3-2-1-8\" data-name=\"double edit cell\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-2-3-2-1-8-1\" data-name=\"pencil icon\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr class=\"bg-[var(--desk-primary-soft)]\" data-kid=\"1-2-2-2-2-3-2-2\" data-name=\"triple room row\">\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-3-2-2-1\" data-name=\"selected row checkbox cell\" data-reason=\"checked state bound to row selection via script\">\n                                    <span class=\"flex size-4 items-center justify-center rounded border border-[var(--desk-primary)] bg-[var(--desk-primary)] text-[10px] text-white\" data-kid=\"1-2-2-2-2-3-2-2-1-1\" data-name=\"checked checkbox\">\n                                        <i class=\"icon-check\" data-kid=\"1-2-2-2-2-3-2-2-1-1-1\" data-name=\"check icon\">\n                                        </i>\n                                    </span>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3\" data-kid=\"1-2-2-2-2-3-2-2-2\" data-name=\"triple room name cell\">\n                                    <p class=\"text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-2-2-1\" data-name=\"triple room title\">\n                                        Triple\n                                        <span class=\"font-normal text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-3-2-2-2-1-1\" data-name=\"triple room guest count\">\n                                            (3 pax)\n                                        </span>\n                                    </p>\n                                    <p class=\"mt-0.5 text-[12px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-3-2-2-2-2\" data-name=\"triple room details\">\n                                        Breakfast · City view ·\n                                        <span class=\"rounded border border-[var(--desk-line)] bg-white px-1.5 py-px text-[10.5px] font-semibold uppercase tracking-[0.04em]\" data-kid=\"1-2-2-2-2-3-2-2-2-2-1\" data-name=\"direct badge\">\n                                            Direct\n                                        </span>\n                                    </p>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3\" data-kid=\"1-2-2-2-2-3-2-2-3\" data-name=\"triple room supplier cell\">\n                                    <span class=\"flex items-center gap-2 text-[13px] font-medium text-[var(--desk-warning-ink)]\" data-kid=\"1-2-2-2-2-3-2-2-3-1\" data-name=\"waiting status label\">\n                                        <span class=\"size-2 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-2-2-2-2-3-2-2-3-1-1\" data-name=\"waiting status dot\">\n                                        </span>\n                                        Waiting\n                                    </span>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-2-2-4\" data-name=\"triple qty cell\">\n                                    3\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-2-2-5\" data-name=\"triple cost cell\">\n                                    240.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-2-6\" data-name=\"triple sell cell\">\n                                    320.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-2-7\" data-name=\"triple amount cell\">\n                                    6,720\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3 text-right text-[13px] text-[var(--desk-muted-soft)]\" data-kid=\"1-2-2-2-2-3-2-2-8\" data-name=\"triple edit cell\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-2-3-2-2-8-1\" data-name=\"pencil icon\">\n                                    </i>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-2-2-3-2-3\" data-name=\"quad room row\">\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-3-2-3-1\" data-name=\"deselected row checkbox cell\" data-reason=\"checked state bound to row selection via script\">\n                                    <span class=\"block size-4 rounded border border-[var(--desk-line-strong)] bg-white\" data-kid=\"1-2-2-2-2-3-2-3-1-1\" data-name=\"unchecked checkbox\">\n                                    </span>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3\" data-kid=\"1-2-2-2-2-3-2-3-2\" data-name=\"quad room name cell\">\n                                    <p class=\"text-[13.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-3-2-1\" data-name=\"quad room title\">\n                                        Quad\n                                        <span class=\"font-normal text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-3-2-3-2-1-1\" data-name=\"quad room guest count\">\n                                            (4 pax)\n                                        </span>\n                                    </p>\n                                    <p class=\"mt-0.5 text-[12px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-3-2-3-2-2\" data-name=\"quad room details\">\n                                        No meals · City view ·\n                                        <span class=\"rounded border border-[var(--desk-line)] bg-white px-1.5 py-px text-[10.5px] font-semibold uppercase tracking-[0.04em]\" data-kid=\"1-2-2-2-2-3-2-3-2-2-1\" data-name=\"direct badge\">\n                                            Direct\n                                        </span>\n                                    </p>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3\" data-kid=\"1-2-2-2-2-3-2-3-3\" data-name=\"quad room supplier cell\">\n                                    <span class=\"flex items-center gap-2 text-[13px] font-medium text-[var(--desk-text-soft)]\" data-kid=\"1-2-2-2-2-3-2-3-3-1\" data-name=\"new status label\">\n                                        <span class=\"size-2 rounded-full bg-[var(--desk-line-strong)]\" data-kid=\"1-2-2-2-2-3-2-3-3-1-1\" data-name=\"new status dot\">\n                                        </span>\n                                        New\n                                    </span>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-2-3-4\" data-name=\"quad qty cell\">\n                                    1\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-2-3-5\" data-name=\"quad cost cell\">\n                                    300.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-3-6\" data-name=\"quad sell cell\">\n                                    400.00\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-2-3-7\" data-name=\"quad amount cell\">\n                                    2,800\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3 text-right text-[13px] text-[var(--desk-muted-soft)]\" data-kid=\"1-2-2-2-2-3-2-3-8\" data-name=\"quad edit cell\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-2-3-2-3-8-1\" data-name=\"pencil icon\">\n                                    </i>\n                                </td>\n                            </tr>\n                        </tbody>\n                        <tfoot data-kid=\"1-2-2-2-2-3-3\" data-name=\"table footer\">\n                            <tr class=\"bg-[var(--desk-canvas)]\" data-kid=\"1-2-2-2-2-3-3-1\" data-name=\"totals row\">\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-2-2-3-3-1-1\" data-name=\"totals spacer cell\">\n                                </td>\n                                <td class=\"px-3 py-3 text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-3-1-2\" data-name=\"totals label\">\n                                    Totals\n                                </td>\n                                <td class=\"px-3 py-3 text-right text-[12px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-2-2-3-3-1-3\" data-name=\"totals nights cell\">\n                                    7 nights\n                                </td>\n                                <td class=\"px-3 py-3 text-right font-semibold\" data-kid=\"1-2-2-2-2-3-3-1-4\" data-name=\"totals qty cell\">\n                                    10\n                                </td>\n                                <td class=\"px-3 py-3 text-right\" data-kid=\"1-2-2-2-2-3-3-1-5\" data-name=\"totals cost cell\">\n                                    15,120\n                                </td>\n                                <td class=\"px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-3-1-6\" data-name=\"totals sell cell\">\n                                    20,020\n                                </td>\n                                <td class=\"px-3 py-3 text-right font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-2-2-2-3-3-1-7\" data-name=\"totals amount cell\">\n                                    20,020\n                                </td>\n                                <td class=\"px-4 py-3\" data-kid=\"1-2-2-2-2-3-3-1-8\" data-name=\"totals spacer cell\">\n                                </td>\n                            </tr>\n                        </tfoot>\n                    </table>\n                </div>\n            </section>\n        </div>\n        <!-- ================= SCRIM ================= -->\n        <div class=\"absolute inset-0 z-30 bg-[rgba(8,28,54,0.55)] backdrop-blur-[3px]\" data-kid=\"1-2-3\" data-name=\"modal background scrim\">\n        </div>\n        <!-- ================= CONFIRMATION DIALOG ================= -->\n        <div class=\"absolute inset-x-0 top-0 z-50 flex items-start justify-center px-4 pt-[88px]\" data-kid=\"1-2-4\" data-name=\"confirmation dialog overlay\">\n            <div aria-describedby=\"cancel-impact\" aria-labelledby=\"cancel-title\" aria-modal=\"true\" class=\"w-[560px] max-w-full overflow-hidden rounded-2xl border border-[var(--desk-line)] bg-white ring-1 ring-[rgba(8,28,54,0.10)] dialog-shadow\" data-kid=\"1-2-4-1\" data-name=\"cancellation confirmation dialog\" role=\"alertdialog\">\n                <div class=\"flex items-start gap-3.5 px-6 pb-5 pt-6\" data-kid=\"1-2-4-1-1\" data-name=\"dialog header\">\n                    <span class=\"flex size-9 shrink-0 items-center justify-center rounded-lg bg-[var(--desk-danger-soft)] text-[17px] text-[var(--desk-danger-ink)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"warning icon container\">\n                        <i class=\"icon-triangle-alert\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"triangle alert icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-1-1-2\" data-name=\"dialog title and summary\">\n                        <h2 class=\"text-[17px] font-semibold tracking-tight text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"dialog headline\" id=\"cancel-title\">\n                            Cancel A00015\n                        </h2>\n                        <p class=\"num mt-1 text-[13px] leading-[19px] text-[var(--desk-text)]\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"booking summary line\">\n                            Manarat ghaza hotel · Mohamed Dellai · ahmed · 31 Oct → 7 Nov 2026\n                        </p>\n                    </div>\n                    <button aria-label=\"Close\" class=\"-mr-1 -mt-1 flex size-8 shrink-0 items-center justify-center rounded-lg text-[15px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-1-3\" data-name=\"close dialog button\">\n                        <i class=\"icon-x\" data-kid=\"1-2-4-1-1-3-1\" data-name=\"close X icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"border-y border-[var(--desk-line-soft)] bg-[var(--desk-canvas)] px-6 py-5\" data-kid=\"1-2-4-1-2\" data-name=\"dialog consequences section\">\n                    <p class=\"text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"consequences section label\">\n                        What happens\n                    </p>\n                    <ul class=\"mt-3\" data-kid=\"1-2-4-1-2-2\" data-name=\"consequences list\" id=\"cancel-impact\">\n                        <li class=\"flex items-start gap-3 border-b border-[var(--desk-line-soft)] pb-3 text-[13.5px] leading-[20px] text-[var(--desk-text)]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"rooms released consequence\">\n                            <i class=\"icon-layers mt-[3px] w-4 shrink-0 text-center text-[14px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"layers icon\">\n                            </i>\n                            <span data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"rooms released consequence text\">\n                                <span class=\"num font-semibold text-[var(--desk-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-2-1-2-1\" data-name=\"rooms count\" data-reason=\"count templated from the booking's room count by script\">\n                                    10 rooms\n                                </span>\n                                are released back to the hotel.\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 border-b border-[var(--desk-line-soft)] py-3 text-[13.5px] leading-[20px] text-[var(--desk-text)]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"hold ends consequence\">\n                            <i class=\"icon-clock mt-[3px] w-4 shrink-0 text-center text-[14px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"hold ends consequence text\">\n                                The hold ends immediately and the booking\n                                <span class=\"font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-2-2-2-2-1\" data-name=\"emphasis phrase cannot be reopened\">\n                                    cannot be reopened.\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"flex items-start gap-3 pt-3 text-[13.5px] leading-[20px] text-[var(--desk-text)]\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"unpaid balance consequence\">\n                            <i class=\"icon-banknote mt-[3px] w-4 shrink-0 text-center text-[14px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"banknote icon\">\n                            </i>\n                            <span data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"unpaid balance consequence text\">\n                                <span class=\"num font-semibold text-[var(--desk-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-2-3-2-1\" data-name=\"unpaid amount\" data-reason=\"amount templated from booking balance by script\">\n                                    SAR 7,510\n                                </span>\n                                is still unpaid; nothing is refunded automatically.\n                            </span>\n                        </li>\n                    </ul>\n                    <p class=\"num mt-3 text-[12px] leading-[17px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-2-3\" data-name=\"payments disclaimer text\">\n                        Payments already recorded (SAR 12,510) must be refunded separately from the Payments tab.\n                    </p>\n                </div>\n                <div class=\"px-6 py-5\" data-kid=\"1-2-4-1-3\" data-name=\"dialog form fields container\">\n                    <div class=\"flex flex-wrap items-start gap-x-6 gap-y-4\" data-kid=\"1-2-4-1-3-1\" data-name=\"penalty and contract fields row\">\n                        <div data-kid=\"1-2-4-1-3-1-1\" data-name=\"penalty field group\">\n                            <label class=\"block text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-1-1-1\" data-name=\"penalty label\">\n                                Cancellation penalty (SAR)\n                            </label>\n                            <div class=\"relative mt-1.5 w-[140px]\" data-kid=\"1-2-4-1-3-1-1-2\" data-name=\"penalty input with currency wrapper\">\n                                <input class=\"fld num w-full pr-11 font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-3-1-1-2-1\" data-name=\"penalty amount input field\" inputmode=\"decimal\" value=\"0\"/>\n                                <span class=\"absolute right-3 top-1/2 -translate-y-1/2 text-[12px] font-semibold text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-1-1-2-2\" data-name=\"currency suffix label\">\n                                    SAR\n                                </span>\n                            </div>\n                            <p class=\"mt-1.5 w-[190px] text-[12px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-1-1-3\" data-name=\"penalty helper text\">\n                                Charged to the agency. Leave at 0 if the hotel waived it.\n                            </p>\n                        </div>\n                        <div class=\"pt-[27px]\" data-kid=\"1-2-4-1-3-1-2\" data-name=\"contract penalty group\">\n                            <button class=\"num flex h-9 items-center gap-2 rounded-lg border border-[var(--desk-line)] bg-white px-3 text-[12.5px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-3-1-2-1\" data-name=\"use contract penalty button\">\n                                <i class=\"icon-file-text text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-1-2-1-1\" data-name=\"file text icon\">\n                                </i>\n                                Use contract penalty · SAR 1,000\n                            </button>\n                            <p class=\"mt-1.5 w-[200px] text-[12px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-1-2-2\" data-name=\"contract reference helper text\">\n                                From the Manarat ghaza contract, clause 4.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-5\" data-kid=\"1-2-4-1-3-2\" data-name=\"reason selection group\">\n                        <label class=\"block text-[10.5px] font-semibold uppercase tracking-[0.06em] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-2-1\" data-name=\"reason label\">\n                            Reason\n                        </label>\n                        <div class=\"caret-down relative mt-1.5 w-[280px]\" data-kid=\"1-2-4-1-3-2-2\" data-name=\"reason dropdown wrapper\">\n                            <select class=\"fld w-full appearance-none pr-9\" data-kid=\"1-2-4-1-3-2-2-1\" data-name=\"reason select field\">\n                                <option data-kid=\"1-2-4-1-3-2-2-1-1\" data-name=\"reason option guest cancelled\">\n                                    Guest cancelled\n                                </option>\n                                <option data-kid=\"1-2-4-1-3-2-2-1-2\" data-name=\"reason option visa refusal\" selected=\"\">\n                                    Visa refusal\n                                </option>\n                                <option data-kid=\"1-2-4-1-3-2-2-1-3\" data-name=\"reason option hotel cannot provide\">\n                                    Hotel cannot provide\n                                </option>\n                                <option data-kid=\"1-2-4-1-3-2-2-1-4\" data-name=\"reason option price change\">\n                                    Price change\n                                </option>\n                                <option data-kid=\"1-2-4-1-3-2-2-1-5\" data-name=\"reason option other\">\n                                    Other\n                                </option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 rounded-lg border border-[var(--desk-line)] bg-[var(--desk-canvas)] p-4\" data-kid=\"1-2-4-1-3-3\" data-name=\"confirmation code block\">\n                        <div class=\"flex flex-wrap items-end gap-x-4 gap-y-2\" data-kid=\"1-2-4-1-3-3-1\" data-name=\"confirmation code row\">\n                            <div data-kid=\"1-2-4-1-3-3-1-1\" data-name=\"confirm code group\">\n                                <label class=\"block text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-3-3-1-1-1\" data-name=\"confirm code label\">\n                                    Type the reservation number to confirm\n                                </label>\n                                <div class=\"relative mt-1.5 w-[150px]\" data-kid=\"1-2-4-1-3-3-1-1-2\" data-name=\"confirm code input with check wrapper\">\n                                    <input class=\"mono fld w-full pr-9 font-medium text-[var(--desk-ink)]\" data-dynamic=\"true\" data-kid=\"1-2-4-1-3-3-1-1-2-1\" data-name=\"reservation code input field\" data-reason=\"value re-set to the booking's reservation number by script\" value=\"A00015\"/>\n                                    <i class=\"icon-check absolute right-3 top-1/2 -translate-y-1/2 text-[14px] text-[var(--desk-success-ink)]\" data-kid=\"1-2-4-1-3-3-1-1-2-2\" data-name=\"match validation check icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <p class=\"pb-2 text-[12px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-3-3-1-2\" data-name=\"confirmation case sensitivity note\">\n                                Case sensitive. This is how we keep a cancellation\n                                <br data-kid=\"1-2-4-1-3-3-1-2-1\" data-name=\"line break\"/>\n                                off the wrong booking.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-[var(--desk-line)] bg-[var(--desk-canvas)] px-6 py-4\" data-kid=\"1-2-4-1-4\" data-name=\"dialog footer\">\n                    <p class=\"min-w-0 flex-1 text-[12px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-4-1-4-1\" data-name=\"footer helper text\">\n                        Rooms are freed as soon as you confirm.\n                    </p>\n                    <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-4-1-4-2\" data-name=\"dialog action buttons\">\n                        <button class=\"flex h-10 items-center rounded-lg border border-[var(--desk-line)] bg-white px-3.5 text-[13px] font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-4-1-4-2-1\" data-name=\"keep booking button\">\n                            Keep the booking\n                        </button>\n                        <button class=\"flex h-10 items-center gap-2 rounded-full bg-[var(--desk-danger-ink)] px-4 text-[13px] font-semibold text-white\" data-kid=\"1-2-4-1-4-2-2\" data-name=\"confirm cancel button\">\n                            <i class=\"icon-ban text-[14px]\" data-kid=\"1-2-4-1-4-2-2-1\" data-name=\"ban circle icon\">\n                            </i>\n                            Cancel reservation\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n",
