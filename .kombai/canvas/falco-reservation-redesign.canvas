-chevron-down pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-[13px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-2-3-2-2-4-2-1-2-2\">\n                                                    </i>\n                                                </div>\n                                            </div>\n                                            <div data-kid=\"1-2-2-1-2-2-3-2-2-4-2-2\">\n                                                <label class=\"flabel block\" data-kid=\"1-2-2-1-2-2-3-2-2-4-2-2-1\" for=\"reference\">\n                                                    Payment reference\n                                                </label>\n                                                <input class=\"mono field mt-1.5\" data-kid=\"1-2-2-1-2-2-3-2-2-4-2-2-2\" id=\"reference\" value=\"auth 4471\"/>\n                                            </div>\n                                        </div>\n                                        <p class=\"mt-2.5 text-[11.5px] leading-[16px] text-[var(--desk-text-soft)]\" data-kid=\"1-2-2-1-2-2-3-2-2-4-3\">\n                                            Cheque date appears for Cheque; a reference field appears for Transfer.\n                                        </p>\n                                    </div>\n                                    <div data-kid=\"1-2-2-1-2-2-3-2-2-5\">\n                                        <label class=\"flabel block\" data-kid=\"1-2-2-1-2-2-3-2-2-5-1\" for=\"note\">\n                                            Description\n                                            <span class=\"font-normal normal-case text-[var(--desk-muted-soft)]\" data-kid=\"1-2-2-1-2-2-3-2-2-5-1-1\">\n                                                (optional)\n                                            </span>\n                                        </label>\n                                        <input class=\"field mt-1.5\" data-kid=\"1-2-2-1-2-2-3-2-2-5-2\" id=\"note\" placeholder=\"e.g. second instalment, agency wire\"/>\n                                    </div>\n                                    <label class=\"flex cursor-pointer items-center gap-2.5 text-[13px] font-medium text-[var(--desk-text)]\" data-kid=\"1-2-2-1-2-2-3-2-2-6\">\n                                        <span class=\"flex size-[18px] shrink-0 items-center justify-center rounded border border-[var(--desk-primary)] bg-[var(--desk-primary)] text-white\" data-kid=\"1-2-2-1-2-2-3-2-2-6-1\">\n                                            <i aria-hidden=\"true\" class=\"icon-check text-[11px]\" data-kid=\"1-2-2-1-2-2-3-2-2-6-1-1\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-2-2-3-2-2-6-2\">\n                                            Down payment\n                                            <input checked=\"\" class=\"sr-only\" data-kid=\"1-2-2-1-2-2-3-2-2-6-2-1\" type=\"checkbox\"/>\n                                        </span>\n                                    </label>\n                                    <div class=\"flex items-center gap-2 border-t border-[var(--desk-line-soft)] pt-3.5\" data-kid=\"1-2-2-1-2-2-3-2-2-7\">\n                                        <button class=\"btn-primary flex-1\" data-kid=\"1-2-2-1-2-2-3-2-2-7-1\" type=\"button\">\n                                            Record payment\n                                        </button>\n                                        <button class=\"btn-quiet\" data-kid=\"1-2-2-1-2-2-3-2-2-7-2\" type=\"button\">\n                                            Discard\n                                        </button>\n                                    </div>\n                                    <p class=\"text-[11.5px] leading-[16px] text-[var(--desk-muted)]\" data-kid=\"1-2-2-1-2-2-3-2-2-8\">\n                                        Recorded payments can be posted to accounting l