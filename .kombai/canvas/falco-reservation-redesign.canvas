der-y border-[var(--desk-line)] px-3 py-2 text-right font-semibold\" data-kid=\"1-2-2-2-2-3-1-1-6\" data-name=\"sell per night header\">\n                                    Sell / night\n                                </th>\n                                <th class=\"border-y border-[var(--desk-line)] px-3 py-2 text-right font-semibold\" data-kid=\"1-2-2-2-2-3-1-1-7\" data-name=\"amount column header\">\n                                    Amount\n                                </th>\n                                <th class=\"w-16 border-y border-[var(--desk-line)] px-4 py-2\" data-kid=\"1-2-2-2-2-3-1-1-8\" data-name=\"actions column header\">\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"num\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"table body\">\n                            <tr class=\"bg-[var(--desk-primary-soft)]\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"double room row\">\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-4 py-3\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-3-2-1-1\" data-name=\"selected row checkbox cell\" data-reason=\"checked state bound to row selection via script\">\n                                    <span class=\"flex size-4 items-center justify-center rounded border border-[var(--desk-primary)] bg-[var(--desk-primary)] text-[10px] text-white\" data-kid=\"1-2-2-2-2-3-2-1-1-1\" data-name=\"checked checkbox\">\n                                        <i class=\"icon-check\" data-kid=\"1-2-2-2-2-3-2-1-1-1-1\" data-name=\"check icon\">\n                                        </i>\n                                    </span>\n                                </td>\n                                <td class=\"border-b border-[var(--desk-line-soft)] px-3 py-3\" data-kid=\"1-2-2-2-2-3-2-1-2\" data-name=\"double room name cell\">\n                                    <p class=\"text-[13.5px] font-semibold