utton class=\"flex min-h-9 items-center gap-1.5 rounded-lg border border-[var(--desk-line)] bg-white px-3 text-[13px] font-semibold text-[var(--desk-ink)] transition hover:bg-[var(--desk-surface-muted)]\" data-kid=\"1-1-2-2-2-2-1-2\">\n                                <i aria-hidden=\"true\" class=\"icon-plus text-[14px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-1-2-1\">\n                                </i>\n                                Add a room\n                            </button>\n                        </header>\n                        <!-- contextual supplier bar -->\n                        <div class=\"px-4 pb-3\" data-kid=\"1-1-2-2-2-2-2\">\n                            <div class=\"flex flex-wrap items-center gap-2.5 rounded-lg border border-[var(--desk-info-line)] bg-[var(--desk-primary-soft)] px-3 py-2.5\" data-kid=\"1-1-2-2-2-2-2-1\">\n                                <span class=\"text-[13px] font-semibold text-[var(--desk-primary-deep)]\" data-kid=\"1-1-2-2-2-2-2-1-1\">\n                                    2 lines selected\n                                </span>\n                                <span aria-hidden=\"true\" class=\"h-5 w-px bg-[var(--desk-info-line)]\" data-kid=\"1-1-2-2-2-2-2-1-2\">\n                                </span>\n                                <span class=\"text-[12.5px] text-[var(--desk-muted)]\" data-kid=\"1-1-2-2-2-2-2-1-3\">\n                                    Send to hotel:\n                                </span>\n                                <button class=\"min-h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-ink)] hover:bg-[var(--desk-canvas)]\" data-kid=\"1-1-2-2-2-2-2-1-4\">\n                                    Request\n                                </button>\n                                <button class=\"min-h-8 rounded-lg border border-[var(--desk-line)] bg-white px-2.5 text-[12.5px] font-semibold text-[var(--desk-ink)] hover:bg-[va