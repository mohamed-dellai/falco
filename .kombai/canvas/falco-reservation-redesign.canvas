var(--desk-muted-soft)]\" data-kid=\"1-2-1-2-1\">\n                    <i class=\"i icon-search text-[15px]\" data-kid=\"1-2-1-2-1-1\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-1-2\">\n                        Search hotels and reservations\n                    </span>\n                </div>\n                <div class=\"flex h-9 items-center gap-2 rounded-lg border border-[var(--desk-line)] px-3 text-[12.5px]\" data-kid=\"1-2-1-2-2\">\n                    <span class=\"font-semibold text-[var(--desk-warning-ink)]\" data-kid=\"1-2-1-2-2-1\">\n                        SAR / USD\n                    </span>\n                    <span class=\"num font-semibold text-[var(--desk-ink)]\" data-kid=\"1-2-1-2-2-2\">\n                        3.7500\n                    </span>\n                </div>\n                <span class=\"relative flex size-9 items-center justify-center rounded-lg text-[17px] text-[var(--desk-text-soft)]\" data-kid=\"1-2-1-2-3\">\n                    <i class=\"i icon-bell\" data-kid=\"1-2-1-2-3-1\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 size-1.5 rounded-full bg-[var(--desk-gold)]\" data-kid=\"1-2-1-2-3-2\">\n                    </span>\n                </span>\n                <span class=\"flex size-8 items-center justify-center rounded-full bg-[var(--desk-ink)] text-[11px] font-bold text-white\" data-kid=\"1-2-1-2-4\">\n                    MD\n                </span>\n            </div>\n        </header>\n        <main class=\"mx-auto max-w-[1600px] px-6 py-5\" data-kid=\"1-2-2\">\n            <div class=\"grid grid-cols-[320px_minmax(0,1fr)] items-start gap-5\" data-kid=\"1-2-2-1\">\n                <!-- ══════════ SUMMARY RAIL ══════════ -->\n                <aside class=\"sticky top-[76px] divide-y divide-[var(--desk-line-soft)] rounded-xl border border-[var(--desk-line)] bg-white\" data-kid=\"1-2-2-1-1\">\n                    <div class=\"p-4\" data-kid=\"1-2-2-1-1-1\