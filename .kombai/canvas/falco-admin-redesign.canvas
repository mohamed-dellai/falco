    },
    "var_13f909f52bc8": {
      "type": "variant",
      "label": "Admin — Requests inbox (redesign)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 1009
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');\n.news { font-family: 'Newsreader', serif; }\n.mono { font-family: 'IBM Plex Mono', monospace; }\nbody { font-family: 'Instrument Sans', sans-serif; }\n:focus-visible { outline: 3px solid #c59b27; outline-offset: 3px; border-radius: 6px; }\n::selection { background: rgba(197,155,39,.28); }\n</style>\n<div class=\"flex min-h-screen bg-[#fbf9f5] text-[#081c36] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ── Sidebar ─────────────────────────────────────────── -->\n    <aside class=\"sticky top-0 z-30 flex h-screen w-[260px] shrink-0 flex-col bg-[#081c36] text-white\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <div class=\"flex items-center gap-3 px-5 pt-6 pb-5\" data-kid=\"1-1-1\" data-name=\"sidebar branding header\">\n            <div class=\"news flex size-9 shrink-0 items-center justify-center rounded-lg border border-[#c59b27]/40 bg-[#c59b27]/15 text-[18px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-1-1\" data-name=\"sidebar logo icon\">\n                F\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"sidebar user info\">\n                <div class=\"news text-[18px] font-semibold leading-tight\" data-kid=\"1-1-1-2-1\" data-name=\"sidebar brand name\">\n                    Falco\n                </div>\n                <div class=\"text-[12px] text-white/55\" data-kid=\"1-1-1-2-2\" data-name=\"sidebar account subtitle\">\n                    Room desk\n                </div>\n            </div>\n        </div>\n        <nav class=\"mt-1 flex flex-col gap-1 px-3\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/70 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-1\" data-name=\"overview link\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-1-1\" data-name=\"overview icon\">\n                </i>\n                Overview\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/70 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-2\" data-name=\"hotels link\" href=\"#\">\n                <i class=\"ti ti-building-hotel text-[17px]\" data-kid=\"1-1-2-2-1\" data-name=\"hotels icon\">\n                </i>\n                Hotels\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/70 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-3\" data-name=\"purchases link\" href=\"#\">\n                <i class=\"ti ti-receipt text-[17px]\" data-kid=\"1-1-2-3-1\" data-name=\"purchases icon\">\n                </i>\n                Purchases\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/70 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-4\" data-name=\"agencies link\" href=\"#\">\n                <i class=\"ti ti-building-store text-[17px]\" data-kid=\"1-1-2-4-1\" data-name=\"agencies icon\">\n                </i>\n                Agencies\n            </a>\n            <a class=\"relative flex items-center gap-3 rounded-lg bg-white/[0.08] px-3 py-2 text-[13.5px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-2-5\" data-name=\"active requests link\" href=\"#\">\n                <i class=\"ti ti-inbox text-[17px]\" data-kid=\"1-1-2-5-1\" data-name=\"requests icon\">\n                </i>\n                Requests\n                <span class=\"absolute inset-y-2 right-1 w-[3px] rounded-full bg-[#c59b27]\" data-kid=\"1-1-2-5-2\" data-name=\"active status indicator\">\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/70 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-6\" data-name=\"allotments link\" href=\"#\">\n                <i class=\"ti ti-bed text-[17px]\" data-kid=\"1-1-2-6-1\" data-name=\"allotments icon\">\n                </i>\n                Allotments\n            </a>\n        </nav>\n        <div class=\"mt-auto border-t border-white/10 px-3 py-4\" data-kid=\"1-1-3\" data-name=\"sidebar utility links\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-3-1\" data-name=\"public site link\" href=\"#\">\n                <i class=\"ti ti-external-link text-[16px]\" data-kid=\"1-1-3-1-1\" data-name=\"public site link icon\">\n                </i>\n                Public site\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-3-2\" data-name=\"log out link\" href=\"#\">\n                <i class=\"ti ti-logout text-[16px]\" data-kid=\"1-1-3-2-1\" data-name=\"log out icon\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <!-- ── Main ────────────────────────────────────────────── -->\n    <main class=\"min-w-0 flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Page header -->\n        <header class=\"sticky top-0 z-20 flex items-end justify-between gap-6 border-b border-[#dfe5ec] bg-[#fbf9f5]/90 px-8 py-5 backdrop-blur\" data-kid=\"1-2-1\" data-name=\"page header\">\n            <div data-kid=\"1-2-1-1\" data-name=\"header title and status\">\n                <h1 class=\"news text-[28px] font-semibold leading-tight tracking-tight\" data-kid=\"1-2-1-1-1\" data-name=\"header page title\">\n                    Requests\n                </h1>\n                <p class=\"mt-0.5 text-[13px] text-[#5c6470]\" data-kid=\"1-2-1-1-2\" data-name=\"header status summary\">\n                    <span class=\"font-medium text-[#081c36]\" data-kid=\"1-2-1-1-2-1\" data-name=\"open requests count\">\n                        14 open\n                    </span>\n                    ·\n                    <span class=\"font-medium text-[#081c36]\" data-kid=\"1-2-1-1-2-2\" data-name=\"new requests count\">\n                        2 new today\n                    </span>\n                    <span class=\"ml-2 inline-block size-1.5 translate-y-[-1px] rounded-full bg-[#c59b27] align-middle\" data-kid=\"1-2-1-1-2-3\" data-name=\"status indicator dot\">\n                    </span>\n                </p>\n            </div>\n            <label class=\"relative block\" data-kid=\"1-2-1-2\" data-name=\"search input container\">\n                <i class=\"ti ti-search absolute top-1/2 left-3 -translate-y-1/2 text-[16px] text-[#5c6470]\" data-kid=\"1-2-1-2-1\" data-name=\"search input icon\">\n                </i>\n                <input aria-label=\"Search requests\" class=\"h-10 w-72 rounded-lg border border-[#dfe5ec] bg-white pr-3 pl-9 text-[13.5px] text-[#081c36] placeholder-[#8a93a0] outline-none transition-colors duration-150 focus:border-[#0e4d8c]\" data-kid=\"1-2-1-2-2\" data-name=\"search text input field\" placeholder=\"Search requests\" type=\"search\"/>\n            </label>\n        </header>\n        <div class=\"flex min-h-[calc(100vh-89px)]\" data-kid=\"1-2-2\" data-name=\"content body wrapper\">\n            <!-- ── Left pane: request list ── -->\n            <section class=\"w-[360px] shrink-0 border-e border-[#dfe5ec] bg-white\" data-kid=\"1-2-2-1\" data-name=\"requests list panel\">\n                <div class=\"border-b border-[#dfe5ec] px-4 py-3\" data-kid=\"1-2-2-1-1\" data-name=\"requests filter toolbar\">\n                    <div class=\"inline-flex items-center gap-1 rounded-lg border border-[#dfe5ec] bg-[#fbf9f5] p-1\" data-kid=\"1-2-2-1-1-1\" data-name=\"filter toggle group\">\n                        <button class=\"rounded-md bg-[#0e4d8c] px-3 py-1.5 text-[13px] font-semibold text-white transition-colors duration-150\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"all requests filter button\">\n                            All\n                            <span class=\"mono ml-1 rounded-full bg-white/20 px-1.5 py-px text-[11.5px]\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"all requests count badge\">\n                                14\n                            </span>\n                        </button>\n                        <button class=\"rounded-md px-3 py-1.5 text-[13px] font-medium text-[#5c6470] transition-colors duration-150 hover:bg-white hover:text-[#081c36]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"allotment requests filter button\">\n                            Allotment\n                            <span class=\"mono ml-1 rounded-full bg-[#f4efea] px-1.5 py-px text-[11.5px]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"allotment requests count badge\">\n                                9\n                            </span>\n                        </button>\n                        <button class=\"rounded-md px-3 py-1.5 text-[13px] font-medium text-[#5c6470] transition-colors duration-150 hover:bg-white hover:text-[#081c36]\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"agency requests filter button\">\n                            Agency\n                            <span class=\"mono ml-1 rounded-full bg-[#f4efea] px-1.5 py-px text-[11.5px]\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"agency requests count badge\">\n                                5\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <ul data-kid=\"1-2-2-1-2\" data-name=\"requests list\">\n                    <li class=\"border-b border-[#eef1f4] transition-colors duration-150 cursor-default bg-[#f4efea] px-4 py-3.5\" data-kid=\"1-2-2-1-2-1\" data-name=\"requests list item selected\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"requests list item content\">\n                            <i class=\"ti ti-bed mt-0.5 text-[16px] text-[#0e4d8c]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"requests list icon\">\n                            </i>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"requests list primary info\">\n                                <div class=\"news text-[15px] leading-tight font-medium\" data-kid=\"1-2-2-1-2-1-1-2-1\" data-name=\"requests list title\">\n                                    Baraka Travels\n                                </div>\n                                <div class=\"mt-1 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-2-1-1-2-2\" data-name=\"requests list metadata\">\n                                    Allotment · 8 Oct → 14 Oct · 9 rooms\n                                </div>\n                            </div>\n                            <div class=\"flex flex-col items-end gap-1.5\" data-kid=\"1-2-2-1-2-1-1-3\" data-name=\"requests list timing info\">\n                                <span class=\"mono text-[11.5px] text-[#081c36]\" data-kid=\"1-2-2-1-2-1-1-3-1\" data-name=\"requests list timestamp\">\n                                    21m\n                                </span>\n                                <span class=\"size-1.5 rounded-full bg-[#c59b27]\" data-kid=\"1-2-2-1-2-1-1-3-2\" data-name=\"requests list new item indicator\" title=\"New today\">\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                    <li class=\"border-b border-[#eef1f4] transition-colors duration-150 hover:bg-[#f4f7fa] cursor-default px-4 py-3.5\" data-kid=\"1-2-2-1-2-2\" data-name=\"requests list item\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"requests list item content\">\n                            <i class=\"ti ti-building-store mt-0.5 text-[16px] text-[#5c6470]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"requests list icon\">\n                            </i>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"requests list primary info\">\n                                <div class=\"news text-[15px] leading-tight font-medium\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"requests list title\">\n                                    Al Manal Hajj\n                                </div>\n                                <div class=\"mt-1 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-2-2-1-2-2\" data-name=\"requests list metadata\">\n                                    Agency application · Casablanca · 320 pilgrims/yr\n                                </div>\n                            </div>\n                            <div class=\"flex flex-col items-end gap-1.5\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"requests list timing info\">\n                                <span class=\"mono text-[11.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-2-2-1-3-1\" data-name=\"requests list timestamp\">\n                                    1h\n                                </span>\n                                <span class=\"size-1.5 rounded-full bg-[#c59b27]\" data-kid=\"1-2-2-1-2-2-1-3-2\" data-name=\"requests list new item indicator\" title=\"New today\">\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                    <li class=\"border-b border-[#eef1f4] transition-colors duration-150 hover:bg-[#f4f7fa] 