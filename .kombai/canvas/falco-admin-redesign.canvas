2-1\">\n                                Use a JPG, PNG, or WebP photo under 5 MB.\n                            </p>\n                            <span class=\"mt-1.5 inline-block text-[12px] font-semibold text-[#b91c1c] cursor-pointer underline underline-offset-2\" data-kid=\"1-2-4-2-5-2-2-2\">\n                                Retry photo\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"fm text-[10px] text-[#5c6470]\" data-kid=\"1-2-4-2-5-3\">\n                        error sits beside the file, not in a global banner\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- FLOW 4 — Cancelling when rooms are held -->\n        <section class=\"bg-white border border-[#dfe5ec] rounded-xl p-6 mt-6\" data-kid=\"1-2-5\">\n            <div class=\"flex items-baseline justify-between mb-5\" data-kid=\"1-2-5-1\">\n                <h2 class=\"fd text-[19px] font-semibold\" data-kid=\"1-2-5-1-1\">\n                    Cancelling when rooms are held\n                </h2>\n                <span class=\"fm text-[10.5px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-5-1-2\">\n                    flow · destructive\n                </span>\n            </div>\n            <div class=\"flex items-stretch gap-3\" data-kid=\"1-2-5-2\">\n                <div class=\"flex-1 min-w-0 rounded-lg bg-[#f7f4ef] p-4 flex flex-col items-start justify-center gap-3\" data-kid=\"1-2-5-2-1\">\n                    <span class=\"fm text-[10px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-5-2-1-1\">\n                        trigger\n                    </span>\n                    <span class=\"h-10 px-4 inline-flex items-center rounded-lg border border-[#d3a6a0] bg-white text-[#b91c1c] text-[13.5px] font-semibold cursor-pointer\" data-kid=\"1-2-5-2-1-2\">\n                        Cancel purchase\n                    </span>\n                    <span class=\"fm text-[10px] text-[#5c6470]\" data-kid=\"1-2-5-2-1-3\">\n                        quiet danger — never a filled primary\n                    </span>\n                </div>\n                <div class=\"flex items-center shrink-0\" data-kid=\"1-2-5-2-2\">\n                    <i class=\"ti ti-arrow-narrow-right text-[20px] text-[#c59b27]\" data-kid=\"1-2-5-2-2-1\">\n                    </i>\n                </div>\n                <div class=\"flex-[1.9] min-w-0 rounded-lg p-1.5\" data-kid=\"1-2-5-2-3\">\n                    <div class=\"relative h-full min-h-[210px] rounded-lg bg-[#081c36]/45 flex items-center justify-center p-4\" data-kid=\"1-2-5-2-3-1\">\n                        <div class=\"w-[360px] rounded-xl bg-white shadow-[0_18px_40px_-10px_rgba(8,28,54,0.45)] p-5\" data-dynamic=\"true\" data-kid=\"1-2-5-2-3-1-1\" data-name=\"cancellation error dialog\" data-reason=\"animated into view by GSAP script\" id=\"dlg\">\n                            <h3 class=\"fd text-[17px] font-semibold leading-snug\" data-kid=\"1-2-5-2-3-1-1-1\">\n                                Can't cancel this purchase\n                            </h3>\n                            <p class=\"mt-2 text-[13px] leading-relaxed text-[#5c6470]\" data-kid=\"1-2-5-2-3-1-1-2\">\n                                Agencies still hold these rooms for those dates. Release the allotments first.\n                            </p>\n                            <div class=\"mt-4 flex justify-end gap-2\" data-kid=\"1-2-5-2-3-1-1-3\">\n                                <span class=\"h-9 px-3 inline-flex items-center rounded-lg border border-[#c5ced8] bg-white text-[13px] font-semibold cursor-pointer\" data-kid=\"1-2-5-2-3-1-1-3-1\">\n                                    View allotments\n                                </span>\n                                <span class=\"h-9 px-4 inline-flex items-center rounded-lg bg-[#0e4d8c] text-white text-[13px] font-semibold cursor-pointer\" data-kid=\"1-2-5-2-3-1-1-3-2\">\n                                    Dismiss\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex items-center shrink-0\" data-kid=\"1-2-5-2-4\">\n                    <i class=\"ti ti-arrow-narrow-right text-[20px] text-[#c59b27]\" data-kid=\"1-2-5-2-4-1\">\n                    </i>\n                </div>\n                <div class=\"flex-[1.2] min-w-0 rounded-lg bg-[#f7f4ef] p-4 flex flex-col justify-center gap-2.5\" data-kid=\"1-2-5-2-5\">\n                    <span class=\"fm text-[10px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-5-2-5-1\">\n                        recovery\n                    </span>\n                    <div class=\"rounded-lg bg-white shadow-[0_12px_32px_-8px_rgba(8,28,54,0.25)] px-4 py-3 flex items-start gap-3\" data-dynamic=\"true\" data-kid=\"1-2-5-2-5-2\" data-name=\"cancellation toast notification\" data-reason=\"animated into view by GSAP script\" id=\"toastError\">\n                        <span class=\"w-2 h-2 rounded-full bg-[#b91c1c] mt-[7px] shrink-0\" data-kid=\"1-2-5-2-5-2-1\">\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"1-2-5-2-5-2-2\">\n                            <p class=\"text-[13px] leading-snug\" data-kid=\"1-2-5-2-5-2-2-1\">\n                                PO-2214 still can't be cancelled\n                            </p>\n                            <div class=\"mt-1.5 flex items-center gap-3\" data-kid=\"1-2-5-2-5-2-2-2\">\n                                <span class=\"text-[12px] font-semibold text-[#0e4d8c] cursor-pointer underline underline-offset-2\" data-kid=\"1-2-5-2-5-2-2-2-1\">\n                                    Open the 2 blocking allotments\n                                </span>\n                                <i class=\"ti ti-x text-[#5c6470] text-[13px] ms-auto shrink-0 cursor-pointer\" data-kid=\"1-2-5-2-5-2-2-2-2\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"fm text-[10px] text-[#5c6470]\" data-kid=\"1-2-5-2-5-3\">\n                        failure names what unblocks it\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- Zero states -->\n        <div class=\"mt-8 mb-4 flex items-baseline justify-between\" data-kid=\"1-2-6\">\n            <h2 class=\"fd text-[19px] font-semibold\" data-kid=\"1-2-6-1\">\n                When there is nothing to show\n            </h2>\n            <span class=\"fm text-[10.5px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-6-2\">\n                states · empty\n            </span>\n        </div>\n        <div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-7\">\n            <div class=\"rounded-xl border border-dashed border-[#cfc7b8] bg-[#f7f4ef] p-8 flex flex-col items-center justify-center text-center\" data-kid=\"1-2-7-1\">\n                <i class=\"ti ti-bed text-[#5c6470]/70 text-[26px]\" data-kid=\"1-2-7-1-1\" data-name=\"empty bed icon\">\n                </i>\n                <p class=\"mt-3 text-[14px] font-semibold\" data-kid=\"1-2-7-1-2\">\n                    No allotments yet\n                </p>\n                <p class=\"mt-1 text-[13px] text-[#5c6470]\" data-kid=\"1-2-7-1-3\">\n                    Create an allotment to hold rooms for an agency.\n                </p>\n                <span class=\"mt-4 h-9 px-4 inline-flex items-center rounded-lg bg-[#0e4d8c] text-white text-[13px] font-semibold cursor-pointer\" data-kid=\"1-2-7-1-4\">\n                    New allotment\n                </span>\n                <p class=\"mt-3 fm text-[10px] text-[#5c6470]\" data-kid=\"1-2-7-1-5\">\n                    empty database — invites the first record\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-dashed border-[#cfc7b8] bg-[#f7f4ef] p-8 flex flex-col items-center justify-center text-center\" data-kid=\"1-2-7-2\">\n                <span class=\"fm inline-flex items-center gap-2 rounded-md bg-white border border-[#e6ebf0] px-3 py-1.5 text-[12px] text-[#081c36]\" data-kid=\"1-2-7-2-1\">\n                    <i class=\"ti ti-search text-[13px] text-[#5c6470]\" data-kid=\"1-2-7-2-1-1\">\n                    </i>\n                    mina\n                </span>\n                <p class=\"mt-3 text-[13.5px]\" data-kid=\"1-2-7-2-2\">\n                    No matches for “\n                    <strong class=\"font-semibold\" data-kid=\"1-2-7-2-2-1\">\n                        mina\n                    </strong>\n                    ” · 31 allotments total\n                </p>\n                <span class=\"mt-2 text-[13px] font-semibold text-[#0e4d8c] cursor-pointer underline underline-offset-2\" data-kid=\"1-2-7-2-3\">\n                    Clear search\n                </span>\n                <p class=\"mt-3 fm text-[10px] text-[#5c6470]\" data-kid=\"1-2-7-2-4\">\n                    zero results ≠ empty database\n                </p>\n            </div>\n        </div>\n        <footer class=\"mt-8 flex items-center gap-3 text-[11px] text-[#5c6470]\" data-kid=\"1-2-8\">\n            <span class=\"fm\" data-kid=\"1-2-8-1\">\n                falco room desk · interface states\n            </span>\n            <span class=\"h-px flex-1 bg-[#dfe5ec]\" data-kid=\"1-2-8-2\">\n            </span>\n            <span class=\"fm\" data-kid=\"1-2-8-3\">\n                14px floor · gold outline on focus · reduced-motion respected\n            </span>\n        </footer>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (!reduce && window.gsap) {\n    gsap.utils.toArray('.skel').forEach(el =>\n      gsap.fromTo(el, { backgroundPosition: '200% 0' }, { backgroundPosition: '-200% 0', duration: 1.6, ease: 'none', repeat: -1 })\n    );\n    const o = { v: 0 }, n = document.getElementById('kpiCount');\n    gsap.to(o, { v: 480, duration: 0.7, ease: 'power2.out', onUpdate: () => { n.textContent = Math.round(o.v); } });\n    gsap.fromTo('#upProgress', { width: '0%' }, { width: '64%', duration: 0.8, ease: 'power2.out' });\n    gsap.to('#spin', { rotation: 360, duration: 1, repeat: -1, ease: 'none', transformOrigin: '50% 50%' });\n    gsap.from('#toastConfirm', { x: 32, opacity: 0, duration: 0.45, ease: 'power2.out' });\n    gsap.from('#dlg', { scale: 0.96, opacity: 0, duration: 0.3, ease: 'power2.out' });\n    gsap.from('#toastError', { x: 32, opacity: 0, duration: 0.45, ease: 'power2.out', delay: 0.1 });\n  }\n</script>\n",
      "comments": [],
      "created": "2026-10-01T14:03:47.930042+00:00",
      "modified": "2026-10-01T14:06:51.684868+00:00",
