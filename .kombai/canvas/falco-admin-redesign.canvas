      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n\n  body { background: #fbf9f5; }\n  :focus-visible { outline: 3px solid #c59b27; outline-offset: 3px; }\n  ::selection { background: color-mix(in srgb, #c59b27 28%, transparent); }\n  .city-fill { transform-origin: left center; }\n  .btn-press:active { transform: scale(.98); }\n</style>\n<div class=\"min-h-screen bg-[#fbf9f5] text-[#081c36] font-['Instrument_Sans'] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Sidebar -->\n    <aside class=\"fixed inset-y-0 left-0 z-30 flex w-[260px] flex-col bg-gradient-to-b from-[#081c36] to-[#0a1d37] text-white\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <a class=\"flex items-baseline gap-2.5 px-5 pt-6 pb-5\" data-kid=\"1-1-1\" data-name=\"sidebar branding link\" href=\"#\">\n            <span class=\"font-['Newsreader'] text-[21px] font-medium tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand name text\">\n                Falco\n            </span>\n            <span class=\"text-[11px] font-medium uppercase tracking-[0.18em] text-white/45\" data-kid=\"1-1-1-2\" data-name=\"application subtitle text\">\n                Room desk\n            </span>\n        </a>\n        <nav class=\"mt-1 grid gap-1 px-3\" data-kid=\"1-1-2\" data-name=\"main menu list\">\n            <a aria-current=\"page\" class=\"relative flex items-center gap-3 rounded-lg bg-white/[0.08] px-3 py-2.5 text-sm font-medium text-[#ffdf98]\" data-kid=\"1-1-2-1\" data-name=\"active dashboard link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                Overview\n                <span class=\"absolute end-0 top-2.5 bottom-2.5 w-[3px] rounded-s-full bg-[#c59b27]\" data-kid=\"1-1-2-1-2\" data-name=\"active menu indicator\">\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-2\" data-name=\"hotels menu link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-building-hotel text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"hotels icon\">\n                </i>\n                Hotels\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-3\" data-name=\"purchases menu link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-receipt text-[18px]\" data-kid=\"1-1-2-3-1\" data-name=\"purchases icon\">\n                </i>\n                Purchases\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-4\" data-name=\"agencies menu link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-building-store text-[18px]\" data-kid=\"1-1-2-4-1\" data-name=\"agencies icon\">\n                </i>\n                Agencies\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-5\" data-name=\"requests menu link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-inbox text-[18px]\" data-kid=\"1-1-2-5-1\" data-name=\"requests icon\">\n                </i>\n                Requests\n                <span class=\"ms-auto rounded-full bg-[#c59b27]/25 px-2 py-0.5 text-xs font-semibold text-[#ffdf98]\" data-kid=\"1-1-2-5-2\" data-name=\"new requests count badge\">\n                    2 new\n                </span>\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-white/60 transition-colors duration-150 hover:bg-white/[0.06] hover:text-white\" data-kid=\"1-1-2-6\" data-name=\"allotments menu link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-bed text-[18px]\" data-kid=\"1-1-2-6-1\" data-name=\"allotments icon\">\n                </i>\n                Allotments\n            </a>\n        </nav>\n        <div class=\"mt-auto grid gap-0.5 border-t border-white/10 px-3 py-4\" data-kid=\"1-1-3\" data-name=\"sidebar footer menu\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/50 transition-colors hover:text-white\" data-kid=\"1-1-3-1\" data-name=\"public site link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-external-link text-[16px]\" data-kid=\"1-1-3-1-1\" data-name=\"public site link icon\">\n                </i>\n                Public site\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/50 transition-colors hover:text-white\" data-kid=\"1-1-3-2\" data-name=\"logout link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-logout text-[16px]\" data-kid=\"1-1-3-2-1\" data-name=\"logout icon\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <!-- Content column -->\n    <div class=\"ps-[260px]\" data-kid=\"1-2\" data-name=\"content column container\">\n        <!-- Sticky top bar -->\n        <header class=\"sticky top-0 z-20 border-b border-[#dfe5ec] bg-[#fbf9f5]/90 backdrop-blur\" data-kid=\"1-2-1\" data-name=\"sticky top header\">\n            <div class=\"flex h-16 items-center gap-4 px-8\" data-kid=\"1-2-1-1\" data-name=\"header inner wrapper\">\n                <h1 class=\"font-['Newsreader'] text-[23px] font-medium tracking-tight\" data-kid=\"1-2-1-1-1\" data-name=\"overview title\">\n                    Overview\n                </h1>\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#dfe5ec] bg-white px-3 py-1 text-xs font-medium text-[#5c6470]\" data-kid=\"1-2-1-1-2\" data-name=\"date and location info pill\">\n                    <i aria-hidden=\"true\" class=\"ti ti-calendar text-[14px]\" data-kid=\"1-2-1-1-2-1\" data-name=\"calendar icon\">\n                    </i>\n                    Today · 1 Oct 2026 · Riyadh\n                </span>\n                <div class=\"ms-auto flex items-center gap-3\" data-kid=\"1-2-1-1-3\" data-name=\"action bar\">\n                    <label class=\"flex h-9 w-64 items-center gap-2 rounded-lg border border-[#dfe5ec] bg-white px-3 transition-colors focus-within:border-[#0e4d8c]\" data-kid=\"1-2-1-1-3-1\" data-name=\"search input wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-search text-[16px] text-[#5c6470]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"search icon\">\n                        </i>\n                        <input class=\"w-full bg-transparent text-sm outline-none placeholder:text-[#8b93a1]\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"search input field\" placeholder=\"Search allotments, hotels\" type=\"search\"/>\n                    </label>\n                    <a class=\"btn-press inline-flex h-9 items-center gap-1.5 rounded-lg border border-[#c5ced8] bg-white px-3.5 text-sm font-semibold text-[#172033] transition-colors hover:border-[#0e4d8c]/45 hover:text-[#0e4d8c]\" data-kid=\"1-2-1-1-3-2\" data-name=\"new hotel button\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-[15px]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"new hotel plus icon\">\n                        </i>\n                        New hotel\n                    </a>\n                    <a class=\"btn-press inline-flex h-9 items-center gap-1.5 rounded-lg bg-[#0e4d8c] px-3.5 text-sm font-semibold text-white shadow-[0_1px_2px_rgba(8,28,54,0.25)] transition-colors hover:bg-[#0c4379]\" data-kid=\"1-2-1-1-3-3\" data-name=\"new purchase button\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-[15px]\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"new purchase plus icon\">\n                        </i>\n                        New purchase\n                    </a>\n                </div>\n            </div>\n        </header>\n        <main class=\"mx-auto grid max-w-[1180px] gap-5 px-8 py-7\" data-kid=\"1-2-2\" data-name=\"main content area\">\n            <!-- 1. Capacity band -->\n            <section class=\"rounded-xl border border-[#dfe5ec] bg-white px-6 py-5\" data-kid=\"1-2-2-1\" data-name=\"capacity today section\">\n                <div class=\"flex items-start justify-between gap-10\" data-kid=\"1-2-2-1-1\" data-name=\"capacity section body\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-2-1-1-1\" data-name=\"capacity metrics area\">\n                        <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"section header wrapper\">\n                            <h2 class=\"font-['Newsreader'] text-[19px] font-medium tracking-tight\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"capacity section title\">\n                                Capacity — today\n                            </h2>\n                            <p class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"capacity summary text\">\n                                <span class=\"font-['IBM_Plex_Mono'] text-[13px] text-[#081c36]\" data-count=\"617\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-1-2-1\" data-name=\"total units counter\" data-reason=\"number text counted up from 0 by script\">\n                                    617\n                                </span>\n                                units across 14 hotels\n                            </p>\n                        </div>\n                        <!-- labels above segments -->\n                        <div class=\"mt-5 flex\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"segment distribution labels\">\n                            <div class=\"w-[77.8%]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"held label wrapper\">\n                                <p class=\"whitespace-nowrap text-[13px] font-medium text-[#0e4d8c]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"held count text\" data-reason=\"number text counted up from 0 by script\">\n                                    Held\n                                    <span class=\"ms-1 align-[-2px] font-['Newsreader'] text-[24px] font-medium tabular-nums\" data-count=\"480\" data-kid=\"1-2-2-1-1-1-2-1-1-1\">\n                                        480\n                                    </span>\n                                    <span class=\"font-sans text-[12px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-2-1-1-2\">\n                                        (78%)\n                                    </span>\n                                </p>\n                            </div>\n                            <div class=\"flex-1 text-right\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"open label wrapper\">\n                                <p class=\"whitespace-nowrap text-[13px] font-medium text-[#9a7a1f]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2-2-1\" data-name=\"open count text\" data-reason=\"number text counted up from 0 by script\">\n                                    Open\n                                    <span class=\"ms-1 align-[-2px] font-['Newsreader'] text-[24px] font-medium tabular-nums\" data-count=\"137\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2-2-1-1\" data-name=\"open counter value\" data-reason=\"number text counted up from 0 by script\">\n                                        137\n                                    </span>\n                                    <span class=\"font-sans text-[12px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-2-2-1-2\" data-name=\"open percentage text\">\n                                        (22%)\n                                    </span>\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"cap-reveal mt-1.5 flex h-3.5 overflow-hidden rounded-full bg-[#f4efea]\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"capacity bar container\">\n                            <div class=\"w-[77.8%] bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"held capacity bar segment\">\n                            </div>\n                            <div class=\"flex-1 border border-l-0 border-[#c59b27] bg-[#ffdf98]\" data-kid=\"1-2-2-1-1-1-3-2\" data-name=\"open capacity bar segment\">\n                            </div>\n                        </div>\n                        <p class=\"mt-2.5 text-xs text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-4\" data-name=\"capacity description text\">\n                            Held = rooms purchased or allotted for today's date in Riyadh.\n                        </p>\n                    </div>\n                    <!-- by city -->\n                    <div class=\"w-[340px] shrink-0 border-s border-[#eef0f3] ps-8\" data-kid=\"1-2-2-1-1-2\" data-name=\"held by city widget\">\n                        <p class=\"text-[13px] font-semibold text-[#081c36]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"held by city title\">\n                            Held by city\n                        </p>\n                        <ul class=\"mt-3 grid gap-3\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"city metrics list\">\n                            <li class=\"grid grid-cols-[62px_1fr_auto] items-center gap-3\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"makkah city row\">\n                                <span class=\"text-[13px] font-medium\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"makkah label\">\n                                    Makkah\n                                </span>\n                                <span class=\"h-2 overflow-hidden rounded-full bg-[#ffdf98]/70\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"makkah bar wrapper\">\n                                    <span class=\"city-fill block h-full w-[81.5%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-2-2-1-2-1\" data-name=\"makkah bar fill\">\n                                    </span>\n                                </span>\n                                <span class=\"whitespace-nowrap text-xs tabular-nums text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-2-1-3\" data-name=\"makkah capacity fraction\">\n                                    <span class=\"font-['IBM_Plex_Mono'] font-medium text-[#081c36]\" data-count=\"268\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-1-3-1\" data-name=\"makkah held count\" data-reason=\"number text counted up from 0 by script\">\n                                        268\n                                    </span>\n                                    of 329\n                                </span>\n                            </li>\n                            <li class=\"grid grid-cols-[62px_1fr_auto] items-center gap-3\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"madinah city row\">\n                                <span class=\"text-[13px] font-medium\" data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"madinah label\">\n                                    Madinah\n                                </span>\n                                <span class=\"h-2 overflow-hidden rounded-full bg-[#ffdf98]/70\" data-kid=\"1-2-2-1-1-2-2-2-2\" data-name=\"madinah bar wrapper\">\n                                    <span class=\"city-fill block h-full w-[74.7%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-2-2-2-2-1\" data-name=\"madinah bar fill\">\n                                    </span>\n                                </span>\n                                <span class=\"whitespace-nowrap text-xs tabular-nums text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-2-2-3\" data-name=\"madinah capacity fraction\">\n                                    <span class=\"font-['IBM_Plex_Mono'] font-medium text-[#081c36]\" data-count=\"142\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-2-3-1\" data-name=\"madinah held count\" data-reason=\"number text counted up from 0 by script\">\n                                        142\n                                    </span>\n                                    of 190\n                                </span>\n                            </li>\n                            <li class=\"grid grid-cols-[62px_1fr_auto] items-center gap-3\" data-kid=\"1-2-2-1-1-2-2-3\" data-name=\"mina city row\">\n                                <span class=\"text-[13px] font-medium\" data-kid=\"1-2-2-1-1-2-2-3-1\" data-name=\"mina label\">\n                                    Mina\n                                </span>\n                                <span class=\"h-2 overflow-hidden rounded-full bg-[#ffdf98]/70\" data-kid=\"1-2-2-1-1-2-2-3-2\" data-name=\"mina bar wrapper\">\n                                    <span class=\"city-fill block h-full w-[71.4%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-2-2-3-2-1\" data-name=\"mina bar fill\">\n                                    </span>\n                                </span>\n                                <span class=\"whitespace-nowrap text-xs tabular-nums text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-2-3-3\" data-name=\"mina capacity fraction\">\n                                    <span class=\"font-['IBM_Plex_Mono'] font-medium text-[#081c36]\" data-count=\"70\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-3-3-1\" data-name=\"mina held count\" data-reason=\"number text counted up from 0 by script\">\n                                        70\n                                    </span>\n                                    of 98\n                                </span>\n                            </li>\n                        </ul>\n                        <p class=\"mt-3 text-xs text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"city widget description text\">\n                            Gold track = units still open for those dates.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <!-- 2. Work queue -->\n            <section class=\"grid gap-4 md:grid-cols-2\" data-kid=\"1-2-2-2\" data-name=\"work queue section\">\n                <a class=\"group block rounded-xl border border-[#dfe5ec] bg-white p-5 transition duration-[250ms] ease-out hover:-translate-y-[2px] hover:border-[#c59b27]/45 hover:shadow-[0_12px_28px_-14px_rgba(8,28,54,0.22)]\" data-kid=\"1-2-2-2-1\" data-name=\"requests queue card\" href=\"#\">\n                    <div class=\"flex items-baseline justify-between\" data-kid=\"1-2-2-2-1-1\" data-name=\"requests header\">\n                        <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"requests card title\">\n                            Requests\n                        </h3>\n                        <span class=\"inline-flex items-center gap-1.5 text-xs font-semibold text-[#9a7a1f]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"requests new status badge\">\n                            <span class=\"size-2 rounded-full bg-[#c59b27]\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"requests badge icon\">\n                            </span>\n                            2 new today\n                        </span>\n                    </div>\n                    <p class=\"mt-0.5 font-['Newsreader'] text-[30px] font-medium leading-none tracking-tight\" data-kid=\"1-2-2-2-1-2\" data-name=\"requests count block\">\n                        <span data-count=\"8\" data-dynamic=\"true