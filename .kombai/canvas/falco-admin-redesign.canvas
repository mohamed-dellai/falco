      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  *:focus-visible { outline: 3px solid #c59b27; outline-offset: 2px; }\n  .font-ui { font-family: 'Instrument Sans', sans-serif; }\n  .font-display { font-family: 'Newsreader', serif; }\n  .font-mnum { font-family: 'IBM Plex Mono', monospace; }\n  .nav-row { transition: background-color 150ms ease, color 150ms ease; }\n  .hotel-row { transition: background-color 150ms ease; }\n  .hotel-row:hover { background-color: #f7f4ee; }\n  .thumb-lift .thumb-img { transition: transform 250ms ease; will-change: transform; }\n  .thumb-lift:hover .thumb-img { transform: scale(1.03); }\n  .row-lift { transition: transform 250ms ease, box-shadow 250ms ease; }\n  .btn-press { transition: transform 100ms ease, background-color 150ms ease, border-color 150ms ease; }\n  .btn-press:active { transform: scale(0.98); }\n  .dropzone { transition: border-color 200ms ease, background-color 200ms ease; }\n  .dropzone:hover { border-color: #c59b27; background-color: #fffaf0; }\n</style>\n<div class=\"font-ui min-h-screen bg-[#fbf9f5] text-[#081c36] text-[14px] antialiased\" data-kid=\"1\">\n    <!-- ============ SIDEBAR ============ -->\n    <aside class=\"fixed inset-y-0 start-0 z-30 flex w-[260px] flex-col bg-[#081c36] text-white\" data-kid=\"1-1\" style=\"background-image: linear-gradient(180deg, #081c36 0%, #0a1d37 100%);\">\n        <a class=\"flex items-center gap-3 px-5 py-5\" data-kid=\"1-1-1\" href=\"#\">\n            <img alt=\"Falco\" class=\"size-[34px] rounded-lg object-cover\" data-kid=\"1-1-1-1\" decoding=\"async\" height=\"34\" loading=\"lazy\" src=\"/api/local/images/public/falco-logo.png\" width=\"34\"/>\n            <span class=\"leading-tight\" data-kid=\"1-1-1-2\">\n                <strong class=\"font-display block text-[17px] font-semibold tracking-tight\" data-kid=\"1-1-1-2-1\">\n                    Falco\n                </strong>\n                <span class=\"text-[12px] text-white/50\" data-kid=\"1-1-1-2-2\">\n                    Room desk\n                </span>\n            </span>\n        </a>\n        <nav class=\"mt-2 grid gap-1 px-3\" data-kid=\"1-1-2\">\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-white/70 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-2-1\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-[18px]\" data-kid=\"1-1-2-1-1\" style=\"color: rgba(255,255,255,.55)\">\n                </i>\n                Overview\n            </a>\n            <a aria-current=\"page\" class=\"nav-row relative flex items-center gap-3 rounded-lg bg-white/10 px-3 py-2.5 text-[14px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-2-2\" href=\"#\">\n                <i class=\"ti ti-building-hotel text-[18px]\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Hotels\n                <span class=\"absolute end-0 top-1.5 bottom-1.5 w-[3px] rounded-full bg-[#c59b27]\" data-kid=\"1-1-2-2-2\">\n                </span>\n            </a>\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-white/70 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-2-3\" href=\"#\">\n                <i class=\"ti ti-receipt text-[18px]\" data-kid=\"1-1-2-3-1\" style=\"color: rgba(255,255,255,.55)\">\n                </i>\n                Purchases\n            </a>\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-white/70 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-2-4\" href=\"#\">\n                <i class=\"ti ti-building-store text-[18px]\" data-kid=\"1-1-2-4-1\" style=\"color: rgba(255,255,255,.55)\">\n                </i>\n                Agencies\n            </a>\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-white/70 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-2-5\" href=\"#\">\n                <i class=\"ti ti-inbox text-[18px]\" data-kid=\"1-1-2-5-1\" style=\"color: rgba(255,255,255,.55)\">\n                </i>\n                Requests\n                <span class=\"font-mnum ms-auto rounded-full bg-[#c59b27]/20 px-1.5 py-0.5 text-[11px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-2-5-2\" data-name=\"request count badge\">\n                    8\n                </span>\n            </a>\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2.5 text-[14px] font-medium text-white/70 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-2-6\" href=\"#\">\n                <i class=\"ti ti-bed text-[18px]\" data-kid=\"1-1-2-6-1\" style=\"color: rgba(255,255,255,.55)\">\n                </i>\n                Allotments\n            </a>\n        </nav>\n        <div class=\"mt-auto grid gap-1 border-t border-white/10 px-3 py-4\" data-kid=\"1-1-3\">\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/60 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-3-1\" href=\"#\">\n                <i class=\"ti ti-external-link text-[15px]\" data-kid=\"1-1-3-1-1\">\n                </i>\n                Public site\n            </a>\n            <a class=\"nav-row flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/60 hover:bg-white/5 hover:text-white\" data-kid=\"1-1-3-2\" href=\"#\">\n                <i class=\"ti ti-logout text-[15px]\" data-kid=\"1-1-3-2-1\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <!-- ============ CONTENT ============ -->\n    <div class=\"ps-[260px]\" data-kid=\"1-2\">\n        <!-- Top bar -->\n        <header class=\"sticky top-0 z-20 border-b border-[#dfe5ec] bg-[#fbf9f5]/90 backdrop-blur\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center gap-4 px-7 py-4\" data-kid=\"1-2-1-1\">\n                <div class=\"min-w-0\" data-kid=\"1-2-1-1-1\">\n                    <h1 class=\"font-display text-[26px] font-semibold leading-tight tracking-tight\" data-kid=\"1-2-1-1-1-1\">\n                        Hotels\n                    </h1>\n                    <p class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-1-1-1-2\">\n                        Inventory across Makkah, Madinah and Mina ·\n                        <span class=\"font-mnum\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"shown hotels count\">\n                            7 of 14\n                        </span>\n                        shown\n                    </p>\n                </div>\n                <div class=\"ms-auto flex items-center gap-3\" data-kid=\"1-2-1-1-2\">\n                    <label class=\"relative block\" data-kid=\"1-2-1-1-2-1\">\n                        <i class=\"ti ti-search pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 text-[16px] text-[#5c6470]\" data-kid=\"1-2-1-1-2-1-1\">\n                        </i>\n                        <input aria-label=\"Search hotels\" class=\"h-10 w-[280px] rounded-lg border border-[#dfe5ec] bg-white ps-9 pe-3 text-[14px] text-[#081c36] placeholder:text-[#8a92a0] focus:border-[#0e4d8c] focus:outline-none\" data-kid=\"1-2-1-1-2-1-2\" placeholder=\"Search hotels\" type=\"search\"/>\n                    </label>\n                    <button class=\"btn-press inline-flex h-10 items-center gap-2 rounded-lg bg-[#0e4d8c] px-4 text-[14px] font-semibold text-white hover:bg-[#0b4076]\" data-kid=\"1-2-1-1-2-2\" type=\"button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-1-1-2-2-1\">\n                        </i>\n                        New hotel\n                    </button>\n                </div>\n            </div>\n        </header>\n        <main class=\"grid grid-cols-[420px_1fr] items-start gap-6 px-7 py-6\" data-kid=\"1-2-2\">\n            <!-- ============ LEFT — hotel list (rows, not boxes) ============ -->\n            <section aria-label=\"Hotel list\" class=\"fade-stagger overflow-hidden rounded-xl border border-[#dfe5ec] bg-white\" data-kid=\"1-2-2-1\">\n                <ul data-kid=\"1-2-2-1-1\">\n                    <li class=\"border-b border-[#eef1f5] last:border-b-0\" data-kid=\"1-2-2-1-1-1\">\n                        <a aria-current=\"true\" class=\"hotel-row thumb-lift flex items-center gap-4 bg-[#f4efea] px-4 py-3.5\" data-kid=\"1-2-2-1-1-1-1\" href=\"#\">\n                            <img alt=\"Elaf Al Salam — Makkah Haram view\" class=\"thumb-img size-14 shrink-0 rounded-lg object-cover\" data-kid=\"1-2-2-1-1-1-1-1\" decoding=\"async\" height=\"56\" loading=\"lazy\" src=\"/api/local/images/public/marketing/haram.jpg\" width=\"56\"/>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-1-1-2\">\n                                <p class=\"font-display truncate text-[16px] font-semibold leading-snug\" data-kid=\"1-2-2-1-1-1-1-2-1\">\n                                    Elaf Al Salam\n                                </p>\n                                <p class=\"mt-0.5 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-1-2-2\">\n                                    Makkah ·\n                                    <span aria-label=\"4 stars\" data-kid=\"1-2-2-1-1-1-1-2-2-1\" style=\"color:#9c7c2c\">\n                                        ★★★★☆\n                                    </span>\n                                    4 · 0.4 km from Haram\n                                </p>\n                            </div>\n                            <div class=\"w-[92px] shrink-0 text-end\" data-kid=\"1-2-2-1-1-1-1-3\">\n                                <p class=\"text-[12.5px] font-medium text-[#081c36]\" data-kid=\"1-2-2-1-1-1-1-3-1\">\n                                    12\n                                    <span class=\"text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-1-3-1-1\">\n                                        room types\n                                    </span>\n                                </p>\n                                <p class=\"font-mnum mt-1 text-[11px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-1-1-3-2\">\n                                    8/10 photos\n                                </p>\n                                <div aria-label=\"8 of 10 photos uploaded\" class=\"mt-1 h-1 w-full rounded-full bg-[#e7ebf0]\" data-kid=\"1-2-2-1-1-1-1-3-3\" role=\"img\">\n                                    <div class=\"h-full w-[80%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-1-1-3-3-1\" data-name=\"quad share units held progress bar\">\n                                    </div>\n                                </div>\n                            </div>\n                        </a>\n                    </li>\n                    <li class=\"border-b border-[#eef1f5] last:border-b-0\" data-kid=\"1-2-2-1-1-2\">\n                        <a class=\"hotel-row thumb-lift flex items-center gap-4 px-4 py-3.5\" data-kid=\"1-2-2-1-1-2-1\" href=\"#\">\n                            <img alt=\"Makkah Clock Royal Tower — Kaaba tawaf\" class=\"thumb-img size-14 shrink-0 rounded-lg object-cover\" data-kid=\"1-2-2-1-1-2-1-1\" decoding=\"async\" height=\"56\" loading=\"lazy\" src=\"/api/local/images/public/marketing/tawaf.jpg\" style=\"object-position: 30% 40%\" width=\"56\"/>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-2-1-2\">\n                                <p class=\"font-display truncate text-[16px] font-semibold leading-snug\" data-kid=\"1-2-2-1-1-2-1-2-1\">\n                                    Makkah Clock Royal Tower\n                                </p>\n                                <p class=\"mt-0.5 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-1-2-2\">\n                                    Makkah ·\n                                    <span aria-label=\"5 stars\" data-kid=\"1-2-2-1-1-2-1-2-2-1\" style=\"color:#9c7c2c\">\n                                        ★★★★★\n                                    </span>\n                                    5 · 0.1 km from Haram\n                                </p>\n                            </div>\n                            <div class=\"w-[92px] shrink-0 text-end\" data-kid=\"1-2-2-1-1-2-1-3\">\n                                <p class=\"text-[12.5px] font-medium text-[#081c36]\" data-kid=\"1-2-2-1-1-2-1-3-1\">\n                                    9\n                                    <span class=\"text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-1-3-1-1\">\n                                        room types\n                                    </span>\n                                </p>\n                                <p class=\"font-mnum mt-1 text-[11px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-2-1-3-2\">\n                                    10/10 photos\n                                </p>\n                                <div aria-label=\"10 of 10 photos uploaded\" class=\"mt-1 h-1 w-full rounded-full bg-[#e7ebf0]\" data-kid=\"1-2-2-1-1-2-1-3-3\" role=\"img\">\n                                    <div class=\"h-full w-full rounded-full bg-[#047857]\" data-kid=\"1-2-2-1-1-2-1-3-3-1\" data-name=\"triple deluxe units held progress bar\">\n                                    </div>\n                                </div>\n                            </div>\n                        </a>\n                    </li>\n                    <li class=\"border-b border-[#eef1f5] last:border-b-0\" data-kid=\"1-2-2-1-1-3\">\n                        <a class=\"hotel-row thumb-lift flex items-center gap-4 px-4 py-3.5\" data-kid=\"1-2-2-1-1-3-1\" href=\"#\">\n                            <img alt=\"Swissôtel Al Maqam — Madinah\" class=\"thumb-img size-14 shrink-0 rounded-lg object-cover\" data-kid=\"1-2-2-1-1-3-1-1\" decoding=\"async\" height=\"56\" loading=\"lazy\" src=\"/api/local/images/public/marketing/madinah.jpg\" style=\"object-position: 60% 30%\" width=\"56\"/>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-3-1-2\">\n                                <p class=\"font-display truncate text-[16px] font-semibold leading-snug\" data-kid=\"1-2-2-1-1-3-1-2-1\">\n                                    Swissôtel Al Maqam\n                                </p>\n                                <p class=\"mt-0.5 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-3-1-2-2\">\n                                    Madinah ·\n                                    <span aria-label=\"5 stars\" data-kid=\"1-2-2-1-1-3-1-2-2-1\" style=\"color:#9c7c2c\">\n                                        ★★★★★\n                                    </span>\n                                    5 · 0.2 km from the Prophet's Mosque\n                                </p>\n                            </div>\n                            <div class=\"w-[92px] shrink-0 text-end\" data-kid=\"1-2-2-1-1-3-1-3\">\n                                <p class=\"text-[12.5px] font-medium text-[#081c36]\" data-kid=\"1-2-2-1-1-3-1-3-1\">\n                                    6\n                                    <span class=\"text-[#5c6470]\" data-kid=\"1-2-2-1-1-3-1-3-1-1\">\n                                        room types\n                                    </span>\n                                </p>\n                                <p class=\"font-mnum mt-1 text-[11px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-3-1-3-2\">\n                                    5/10 photos\n                                </p>\n                                <div aria-label=\"5 of 10 photos uploaded\" class=\"mt-1 h-1 w-full rounded-full bg-[#e7ebf0]\" data-kid=\"1-2-2-1-1-3-1-3-3\" role=\"img\">\n                                    <div class=\"h-full w-[50%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-3-1-3-3-1\" data-name=\"double view units held progress bar\">\n                                    </div>\n                                </div>\n                            </div>\n                        </a>\n                    </li>\n                    <li class=\"border-b border-[#eef1f5] last:border-b-0\" data-kid=\"1-2-2-1-1-4\">\n                        <a class=\"hotel-row thumb-lift flex items-center gap-4 px-4 py-3.5\" data-kid=\"1-2-2-1-1-4-1\" href=\"#\">\n                            <img alt=\"Front Row Hotel Madinah — pilgrims\" class=\"thumb-img size-14 shrink-0 rounded-lg object-cover\" data-kid=\"1-2-2-1-1-4-1-1\" decoding=\"async\" height=\"56\" loading=\"lazy\" src=\"/api/local/images/public/marketing/pilgrims.jpg\" style=\"object-position: 50% 60%\" width=\"56\"/>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-4-1-2\">\n                                <p class=\"font-display truncate text-[16px] font-semibold leading-snug\" data-kid=\"1-2-2-1-1-4-1-2-1\">\n                                    Front Row Hotel\n                                </p>\n                                <p class=\"mt-0.5 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-4-1-2-2\">\n                                    Madinah ·\n                                    <span aria-label=\"4 stars\" data-kid=\"1-2-2-1-1-4-1-2-2-1\" style=\"color:#9c7c2c\">\n                                        ★★★★☆\n                                    </span>\n                                    4 · 0.5 km from the Prophet's Mosque\n                                </p>\n                            </div>\n                            <div class=\"w-[92px] shrink-0 text-end\" data-kid=\"1-2-2-1-1-4-1-3\">\n                                <p class=\"text-[12.5px] font-medium text-[#081c36]\" data-kid=\"1-2-2-1-1-4-1-3-1\">\n                                    8\n                                    <span class=\"text-[#5c6470]\" data-kid=\"1-2-2-1-1-4-1-3-1-1\">\n                                        room types\n                                    </span>\n                                </p>\n                                <p class=\"font-mnum mt-1 text-[11px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-4-1-3-2\">\n                                    8/10 photos\n                                </p>\n                                <div aria-label=\"8 of 10 photos uploaded\" class=\"mt-1 h-1 w-full rounded-full bg-[#e7ebf0]\" data-kid=\"1-2-2-1-1-4-1-3-3\" role=\"img\">\n                                    <div class=\"h-full w-[80%] rounded-full bg-[#0e4d8c]\" data-kid=\"1-2-2-1-1-4-1-3-3-1\" data-name=\"haram view suite units held progress bar\">\n                                    </div>\n                                </div>\n                            </div>\n                        </a>\n                    </li>\n                    <li class=\"border-b border-[#eef1f5] last:border-b-0\" data-kid=\"1-2-2-1-1-5\">\n                        <a class=\"hotel-row thumb-lift flex items-center gap-4 px-4 py-3.5\" data-kid=\"1-2-2-1-1-5-1\" href=\"#\">\n                            <img alt=\"Grand Al Massa — Mina tents\" class=\"thumb-img size-14 shrink-0 rounded-lg object-cover\" data-kid=\"1-2-2-1-1-5-1-1\" decoding=\"async\" height=\"56\" loading=\"lazy\" src=\"/api/local/images/public/marketing/mina.jpg\" style=\"object-position: 40% 50%\" width=\"56\"/>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-1-5-1-2\">\n                                <p class=\"font-display truncate text-[16px] font-semibold leading-snug\" data-kid=\"1-2-2-1-1-5-1-2-1\">\n                                    Grand Al Massa\n                                </p>\n                                <p class=\"mt-0.5 truncate text-[12.5px] text-[#5c6470]\" data-kid=\"1-2-2-1-1-5-1-2-2\">\n                                    Mina ·\n                                    <span aria-label=\"4 stars\" data-kid=\"1-2-2-1-1-5-1-2-2-1\" style=\"color:#9c7c