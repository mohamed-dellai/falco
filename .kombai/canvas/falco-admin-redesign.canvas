>\n                                        Travellers\n                                    </dt>\n                                    <dd class=\"mono text-[13.5px]\" data-kid=\"1-2-2-2-1-3-1-2-3-2\" data-name=\"trip travellers value\">\n                                        24\n                                    </dd>\n                                </div>\n                                <div class=\"flex items-baseline justify-between border-b border-[#eef1f4] py-2\" data-kid=\"1-2-2-2-1-3-1-2-4\" data-name=\"trip rooms row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-1-2-4-1\" data-name=\"trip rooms label\">\n                                        Rooms\n                                    </dt>\n                                    <dd class=\"mono text-[13.5px]\" data-kid=\"1-2-2-2-1-3-1-2-4-2\" data-name=\"trip rooms value\">\n                                        9\n                                    </dd>\n                                </div>\n                                <div class=\"flex items-baseline justify-between py-2\" data-kid=\"1-2-2-2-1-3-1-2-5\" data-name=\"trip room type row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-1-2-5-1\" data-name=\"trip room type label\">\n                                        Requested room\n                                    </dt>\n                                    <dd class=\"text-[13.5px] font-medium\" data-kid=\"1-2-2-2-1-3-1-2-5-2\" data-name=\"trip room type value\">\n                                        Triple Deluxe\n                                    </dd>\n                                </div>\n                            </dl>\n                        </div>\n                        <div class=\"reveal\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"contact details section\">\n                            <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-1-3-2-1\" data-name=\"contact section title\">\n                                Contact\n                            </h3>\n                            <dl class=\"mt-2.5\" data-kid=\"1-2-2-2-1-3-2-2\" data-name=\"contact field list\">\n                                <div class=\"flex items-baseline justify-between border-b border-[#eef1f4] py-2\" data-kid=\"1-2-2-2-1-3-2-2-1\" data-name=\"contact name row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-2-2-1-1\" data-name=\"contact name label\">\n                                        Contact\n                                    </dt>\n                                    <dd class=\"text-[13.5px] font-medium\" data-kid=\"1-2-2-2-1-3-2-2-1-2\" data-name=\"contact name value\">\n                                        Youssef El Amrani\n                                    </dd>\n                                </div>\n                                <div class=\"flex items-baseline justify-between border-b border-[#eef1f4] py-2\" data-kid=\"1-2-2-2-1-3-2-2-2\" data-name=\"contact email row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-2-2-2-1\" data-name=\"contact email label\">\n                                        Email\n                                    </dt>\n                                    <dd class=\"text-[13.5px]\" data-kid=\"1-2-2-2-1-3-2-2-2-2\" data-name=\"contact email value\">\n                                        baraka@example.com\n                                    </dd>\n                                </div>\n                                <div class=\"flex items-baseline justify-between border-b border-[#eef1f4] py-2\" data-kid=\"1-2-2-2-1-3-2-2-3\" data-name=\"contact phone row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-2-2-3-1\" data-name=\"contact phone label\">\n                                        Phone\n                                    </dt>\n                                    <dd class=\"mono text-[13.5px]\" data-kid=\"1-2-2-2-1-3-2-2-3-2\" data-name=\"contact phone value\">\n                                        +212 522 000 414\n                                    </dd>\n                                </div>\n                                <div class=\"flex items-baseline justify-between py-2\" data-kid=\"1-2-2-2-1-3-2-2-4\" data-name=\"contact country row\">\n                                    <dt class=\"text-[13px] text-[#5c6470]\" data-kid=\"1-2-2-2-1-3-2-2-4-1\" data-name=\"contact country label\">\n                                        Country\n                                    </dt>\n                                    <dd class=\"text-[13.5px]\" data-kid=\"1-2-2-2-1-3-2-2-4-2\" data-name=\"contact country value\">\n                                        Morocco\n                                    </dd>\n                                </div>\n                            </dl>\n                        </div>\n                    </div>\n                    <!-- Requirements -->\n                    <div class=\"reveal px-6 pb-6\" data-kid=\"1-2-2-2-1-4\" data-name=\"requirements section\">\n                        <h3 class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"requirements title\">\n                            Requirements\n                        </h3>\n                        <p class=\"mt-2 rounded-lg bg-[#f4efea] px-4 py-3 text-[13.5px] leading-relaxed text-[#081c36]\" data-kid=\"1-2-2-2-1-4-2\" data-name=\"requirements description\">\n                            Ground-floor rooms near Haram gate 73; two quad-share alternatives if unavailable.\n                        </p>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n    <!-- ── Toast specimen (L2: shadow only, no border) ── -->\n    <div class=\"fixed right-6 bottom-6 z-40 flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-[0_12px_32px_rgba(8,28,54,0.18),0_2px_6px_rgba(8,28,54,0.08)]\" data-kid=\"1-3\" data-name=\"notification toast\" id=\"toast\">\n        <i class=\"ti ti-circle-check-filled text-[19px] text-emerald-600\" data-kid=\"1-3-1\" data-name=\"toast success icon\">\n        </i>\n        <p class=\"text-[13.5px]\" data-kid=\"1-3-2\" data-name=\"toast message text\">\n            <span class=\"font-semibold\" data-kid=\"1-3-2-1\" data-name=\"toast action confirmation\">\n                Marked quoted\n            </span>\n            <span class=\"text-[#5c6470]\" data-kid=\"1-3-2-2\" data-name=\"toast status detail\">\n                — reply drafted for\n            </span>\n            <span class=\"mono text-[12.5px]\" data-kid=\"1-3-2-3\" data-name=\"toast contact email\">\n                baraka@example.com\n            </span>\n        </p>\n        <button class=\"ml-1 text-[13px] font-semibold text-[#0e4d8c] underline-offset-4 hover:underline\" data-kid=\"1-3-3\" data-name=\"toast undo button\">\n            Undo\n        </button>\n        <button aria-label=\"Dismiss\" class=\"ml-1 text-[15px] text-[#5c6470] transition-colors duration-150 hover:text-[#081c36]\" data-kid=\"1-3-4\" data-name=\"toast dismiss button\">\n            <i class=\"ti ti-x\" data-kid=\"1-3-4-1\" data-name=\"toast dismiss icon\">\n            </i>\n        </button>\n    </div>\n</div>\n<link data-kid=\"2\" data-name=\"tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (function () {\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (reduce) return;\n  gsap.from('.reveal', { opacity: 0, y: 4, duration: 0.35, ease: 'power2.out', stagger: 0.05, delay: 0.1 });\n  gsap.from('#toast', { x: 32, opacity: 0, duration: 0.5, ease: 'power3.out', delay: 0.45 });\n})();\n</script>\n",
