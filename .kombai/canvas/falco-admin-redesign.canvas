ySelectorAll('[data-count]').forEach(function (el, i) {\n      var end = parseFloat(el.dataset.count);\n      var o = { v: 0 };\n      gsap.to(o, {\n        v: end,\n        duration: 0.7,\n        delay: 0.06 * i,\n        ease: 'power2.out',\n        onUpdate: function () {\n          el.textContent = Math.round(o.v).toLocaleString('en-US');\n        }\n      });\n    });\n\n    gsap.fromTo('.cap-reveal',\n      { clipPath: 'inset(0 100% 0 0)' },\n      { clipPath: 'inset(0 0% 0 0)', duration: 0.9, ease: 'power2.out', delay: 0.15 });\n\n    document.querySelectorAll('.city-fill').forEach(function (el, i) {\n      gsap.fromTo(el, { scaleX: 0 }, { scaleX: 1, duration: 0.7, delay: 0.25 + i * 0.08, ease: 'power2.out' });\n    });\n  })();\n</script>\n",
