    <!-- FLOW 2 — Confirming a purchase -->\n        <section class=\"bg-white border border-[#dfe5ec] rounded-xl p-6 mt-6\" data-kid=\"1-2-3\">\n            <div class=\"flex items-baseline justify-between mb-5\" data-kid=\"1-2-3-1\">\n                <h2 class=\"fd text-[19px] font-semibold\" data-kid=\"1-2-3-1-1\">\n                    Confirming a purchase\n                </h2>\n                <span class=\"fm text-[10.5px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-3-1-2\">\n                    flow · write\n                </span>\n            </div>\n            <div class=\"flex items-stretch gap-3\" data-kid=\"1-2-3-2\">\n                <div class=\"flex-1 min-w-0 rounded-lg bg-[#f7f4ef] p-4 flex flex-col items-start justify-center gap-3\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"fm text-[10px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-3-2-1-1\">\n                        rest\n                    </span>\n                    <span class=\"h-10 w-[176px] inline-flex items-center justify-center rounded-lg bg-[#0e4d8c] text-white text-[13.5px] font-semibold\" data-kid=\"1-2-3-2-1-2\">\n                        Confirm purchase\n                    </span>\n                </div>\n                <div class=\"flex items-center shrink-0\" data-kid=\"1-2-3-2-2\">\n                    <i class=\"ti ti-arrow-narrow-right text-[20px] text-[#c59b27]\" data-kid=\"1-2-3-2-2-1\">\n                    </i>\n                </div>\n                <div class=\"flex-1 min-w-0 rounded-lg bg-[#f7f4ef] p-4 flex flex-col items-start justify-center gap-3\" data-kid=\"1-2-3-2-3\">\n                    <span class=\"fm text-[10px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-3-2-3-1\">\n                        pending\n                    </span>\n                    <span class=\"h-10 w-[176px] inline-flex items-center justify-center gap-2 rounded-lg bg-[#0e4d8c]/55 text-white text-[13.5px] font-semibold select-none\" dat