ute inset-0 size-full object-cover opacity-25\" data-kid=\"1-2-2-2-3-2-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/marketing/haram.jpg\" style=\"object-position: 35% 45%; filter: saturate(.4);\"/>\n                            <div class=\"absolute inset-0 grid place-items-center\" data-kid=\"1-2-2-2-3-2-4-2\">\n                                <div class=\"relative size-[64px]\" data-kid=\"1-2-2-2-3-2-4-2-1\">\n                                    <svg aria-hidden=\"true\" class=\"size-full -rotate-90\" data-kid=\"1-2-2-2-3-2-4-2-1-1\" viewbox=\"0 0 52 52\">\n                                        <circle cx=\"26\" cy=\"26\" fill=\"none\" r=\"22\" stroke=\"rgba(255,255,255,.22)\" stroke-dasharray=\"3 4.4\" stroke-width=\"3\">\n                                        </circle>\n                                        <circle cx=\"26\" cy=\"26\" fill=\"none\" id=\"ringProgress\" r=\"22\" stroke=\"#c59b27\" stroke-dasharray=\"138.23\" stroke-dashoffset=\"138.23\" stroke-linecap=\"round\" stroke-width=\"3\">\n                                        </circle>\n                                    </svg>\n                                    <span class=\"font-mnum absolute inset-0 grid place-items-center text-[13px] font-semibold text-[#ffdf98]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-4-2-1-2\" data-name=\"photo upload percentage text\" data-reason=\"text content updated by GSAP animation\" id=\"ringPct\">\n                                        0%\n                                    </span>\n                                </div>\n                            </div>\n                            <p class=\"absolute inset-x-0 bottom-1.5 text-center text-[11px] text-white/85\" data-kid=\"1-2-2-2-3-2-4-3\">\n                                haram-view-02.jpg\n                            </p>\n                        </div>\n                        <!-- Failed tile -->\n                        <div aria-label=\"Upload failed for room-quad-01.png\" class=\"relative aspect-[4/3] overflow-hidden rounded-lg border border-[#fecaca] bg-[#fef2f2]\" data-kid=\"1-2-2-2-3-2-5\">\n                            <img alt=\"\" class=\"absolute inset-0 size-full object-cover opacity-30\" data-kid=\"1-2-2-2-3-2-5-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/marketing/mina.jpg\" style=\"filter: grayscale(.5);\"/>\n                            <div class=\"absolute inset-0 flex flex-col items-center justify-center gap-1.5 bg-[#7f1d1d]/5 px-3 text-center\" data-kid=\"1-2-2-2-3-2-5-2\" data-name=\"upload error container\">\n                                <i class=\"ti ti-alert-circle text-[22px] text-[#b91c1c]\" data-kid=\"1-2-2-2-3-2-5-2-1\">\n                                </i>\n                                <p class=\"text-[12.5px] leading-snug font-semibold text-[#7f1d1d]\" data-kid=\"1-2-2-2-3-2-5-2-2\" data-name=\"upload error title\">\n                                    Upload failed\n                                </p>\n                                <p class=\"text-[11.5px] leading-snug text-[#b91c1c]\" data-kid=\"1-2-2-2-3-2-5-2-3\" data-name=\"upload error message\">\n                                    PNG over 5 MB — convert to JPG or WebP\n                                </p>\n                                <button class=\"btn-press mt-1 inline-flex items-center gap-1.5 rounded-md border border-[#b91c1c]/40 bg-white px-2.5 py-1 text-[12px] font-semibold text-[#b91c1c] hover:bg-[#fff5f5]\" data-kid=\"1-2-2-2-3-2-5-2-4\" data-name=\"retry upload button\" type=\"button\">\n                                    <i class=\"ti ti-refresh text-[14px]\" data-kid=\"1-2-2-2-3-2-5-2-4-1\">\n                                    </i>\n                                    Retry photo\n                                </button>\n                            </div>\n                        </div>\n                        <!-- Drop zone -->\n                        <button aria-label=\"Add photos\" class=\"dropzone aspect-[4/3] rounded-lg border-2 border-dashed border-[#c5ced8] bg-transparent text-[#5c6470]\" data-kid=\"1-2-2-2-3-2-6\" type=\"button\">\n                            <span class=\"flex size-full flex-col items-center justify-center gap-1.5\" data-kid=\"1-2-2-2-3-2-6-1\">\n                                <i class=\"ti ti-cloud-upload text-[22px]\" data-kid=\"1-2-2-2-3-2-6-1-1\">\n                                </i>\n                                <span class=\"text-[12.5px] font-semibold text-[#0e4d8c]\" data-kid=\"1-2-2-2-3-2-6-1-2\">\n                                    Add photos\n                                </span>\n                                <span class=\"text-[11px]\" data-kid=\"1-2-2-2-3-2-6-1-3\">\n                                    or drop files\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (function () {\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      document.getElementById('ringProgress').setAttribute('stroke-dashoffset', '38.7');\n      document.getElementById('ringPct').textContent = '72%';\n      return;\n    }\n    var tl = gsap.timeline({ defaults: { duration: 0.4, ease: 'power2.out' } });\n    tl.from('.fade-stagger', { autoAlpha: 0, y: 8, stagger: 0.05 });\n    // Ring: circumference = 2*pi*22 = 138.23 ; 72% -> offset 38.70\n    tl.to('#ringProgress', { attr: { 'stroke-dashoffset': 38.7 }, duration: 1.1, ease: 'power2.inOut' }, 0.3);\n    var obj = { v: 0 };\n    tl.to(obj, {\n      v: 72, duration: 1.1, ease: 'power2.inOut',\n      onUpdate: function () { document.getElementById('ringPct').textContent = Math.round(obj.v) + '%'; }\n    }, 0.3);\n  })();\n</script>\n",
