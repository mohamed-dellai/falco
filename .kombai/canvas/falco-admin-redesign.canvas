    },
    "var_beb47222fd48": {
      "type": "variant",
      "label": "Admin — Allotments & purchases (redesign)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 1000
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600;7..72,700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  .ff-display { font-family: 'Newsreader', serif; }\n  .ff-mono   { font-family: 'IBM Plex Mono', monospace; }\n  :focus-visible { outline: 3px solid #c59b27; outline-offset: 3px; border-radius: 6px; }\n  .num { font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"min-h-screen bg-[#fbf9f5] text-[#081c36] antialiased\" data-kid=\"1\" style=\"font-family:'Instrument Sans',sans-serif\">\n    <!-- ===================== SIDEBAR ===================== -->\n    <aside class=\"fixed inset-y-0 start-0 z-30 flex w-60 flex-col text-white\" data-kid=\"1-1\" style=\"background:linear-gradient(180deg,#081c36 0%,#0a1d37 100%)\">\n        <a class=\"flex items-center gap-3 px-5 pt-6 pb-5\" data-kid=\"1-1-1\" href=\"#\">\n            <span class=\"flex size-9 items-center justify-center rounded-lg border border-[#c59b27]/40 bg-[#c59b27]/15 ff-display text-[17px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-1-1\">\n                F\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                <strong class=\"block ff-display text-[15px] font-semibold leading-tight\" data-kid=\"1-1-1-2-1\">\n                    Falco\n                </strong>\n                <small class=\"text-[11px] tracking-wide text-white/50\" data-kid=\"1-1-1-2-2\">\n                    Room desk\n                </small>\n            </span>\n        </a>\n        <nav class=\"mt-1 grid gap-0.5 px-3\" data-kid=\"1-1-2\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white/90\" data-kid=\"1-1-2-1\" href=\"#\">\n                <i class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"1-1-2-1-1\">\n                </i>\n                Overview\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white/90\" data-kid=\"1-1-2-2\" href=\"#\">\n                <i class=\"ti ti-building-hotel text-[17px]\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Hotels\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white/90\" data-kid=\"1-1-2-3\" href=\"#\">\n                <i class=\"ti ti-receipt text-[17px]\" data-kid=\"1-1-2-3-1\">\n                </i>\n                Purchases\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white/90\" data-kid=\"1-1-2-4\" href=\"#\">\n                <i class=\"ti ti-building-store text-[17px]\" data-kid=\"1-1-2-4-1\">\n                </i>\n                Agencies\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/60 transition-colors hover:bg-white/5 hover:text-white/90\" data-kid=\"1-1-2-5\" href=\"#\">\n                <i class=\"ti ti-inbox text-[17px]\" data-kid=\"1-1-2-5-1\">\n                </i>\n                Requests\n            </a>\n            <a class=\"relative flex items-center gap-3 rounded-lg bg-white/10 px-3 py-2 text-[13.5px] font-semibold text-[#ffdf98]\" data-kid=\"1-1-2-6\" href=\"#\">\n                <i class=\"ti ti-bed text-[17px]\" data-kid=\"1-1-2-6-1\">\n                </i>\n                Allotments\n                <span class=\"absolute end-0 top-1/2 h-5 w-[3px] -translate-y-1/2 rounded-full bg-[#c59b27]\" data-kid=\"1-1-2-6-2\">\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto grid gap-0.5 border-t border-white/8 px-3 py-4\" data-kid=\"1-1-3\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/50 transition-colors hover:bg-white/5 hover:text-white\" data-kid=\"1-1-3-1\" href=\"#\">\n                <i class=\"ti ti-external-link text-[16px]\" data-kid=\"1-1-3-1-1\">\n                </i>\n                Public site\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-medium text-white/50 transition-colors hover:bg-white/5 hover:text-white\" data-kid=\"1-1-3-2\" href=\"#\">\n                <i class=\"ti ti-logout text-[16px]\" data-kid=\"1-1-3-2-1\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <!-- ===================== CONTENT ===================== -->\n    <main class=\"ps-60\" data-kid=\"1-2\">\n        <div class=\"px-8 pb-36 pt-7\" data-kid=\"1-2-1\">\n            <!-- Page header -->\n            <div class=\"mb-6 flex items-end justify-between gap-4\" data-kid=\"1-2-1-1\">\n                <div data-kid=\"1-2-1-1-1\">\n                    <h1 class=\"ff-display text-[24px] font-semibold leading-none tracking-tight\" data-kid=\"1-2-1-1-1-1\">\n                        Allotments\n                    </h1>\n                    <p class=\"mt-2 text-[13px] text-[#5c6470]\" data-kid=\"1-2-1-1-1-2\">\n                        31 allotments across 12 agencies · held rooms update at Riyadh check-in times\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-1-2\">\n                    <a class=\"inline-flex h-10 items-center rounded-lg border border-[#dfe5ec] bg-white px-4 text-[13.5px] font-semibold text-[#334155] transition-colors hover:border-[#c59b27]/60\" data-kid=\"1-2-1-1-2-1\" href=\"#\">\n                        New purchase\n                    </a>\n                    <a class=\"inline-flex h-10 items-center gap-2 rounded-lg bg-[#0e4d8c] px-4 text-[13.5px] font-semibold text-white transition-colors hover:bg-[#0c4278]\" data-kid=\"1-2-1-1-2-2\" href=\"#\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-1-1-2-2-1\">\n                        </i>\n                        New allotment\n                    </a>\n                </div>\n            </div>\n            <!-- Filter bar : one flat L0 strip -->\n            <div class=\"mb-5 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-xl border border-[#dfe5ec] bg-white px-4 py-3\" data-kid=\"1-2-1-2\">\n                <div class=\"flex items-center gap-1 rounded-lg bg-[#f4efea] p-1\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"rounded-md bg-white px-3.5 py-1.5 text-[13px] font-semibold text-[#081c36] shadow-[0_1px_2px_rgba(8,28,54,.08)]\" data-kid=\"1-2-1-2-1-1\">\n                        Allotments\n                    </span>\n                    <span class=\"rounded-md px-3.5 py-1.5 text-[13px] font-medium text-[#5c6470] transition-colors hover:text-[#081c36]\" data-kid=\"1-2-1-2-1-2\">\n                        Purchases\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-1-2-2\">\n                    <span class=\"inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-[#0e4d8c] px-3 py-1.5 text-[12.5px] font-semibold text-white transition-transform hover:scale-[1.02]\" data-kid=\"1-2-1-2-2-1\">\n                        <span class=\"size-1.5 rounded-full bg-emerald-300\" data-kid=\"1-2-1-2-2-1-1\">\n                        </span>\n                        In house\n                    </span>\n                    <span class=\"inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-[#0e4d8c] px-3 py-1.5 text-[12.5px] font-semibold text-white transition-transform hover:scale-[1.02]\" data-kid=\"1-2-1-2-2-2\">\n                        <span class=\"size-1.5 rounded-full bg-sky-300\" data-kid=\"1-2-1-2-2-2-1\">\n                        </span>\n        