      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.fd{font-family:'Newsreader',serif}\n.fm{font-family:'IBM Plex Mono',monospace}\n.skel{background:linear-gradient(90deg,#e9eef4 0%,#dde5ee 40%,#e9eef4 80%);background-size:220% 100%}\n</style>\n<div class=\"min-h-screen flex bg-[#fbf9f5] text-[#081c36]\" data-kid=\"1\" style=\"font-family:'Instrument Sans',sans-serif\">\n    <!-- Sidebar -->\n    <aside class=\"fixed inset-y-0 left-0 w-[260px] z-40 flex flex-col bg-gradient-to-b from-[#081c36] to-[#0a1d37] text-white\" data-kid=\"1-1\">\n        <a class=\"flex items-center gap-3 px-5 py-5 cursor-pointer\" data-kid=\"1-1-1\">\n            <span class=\"w-9 h-9 rounded-lg bg-white/10 border border-white/15 flex items-center justify-center fd text-[18px] text-[#ffdf98]\" data-kid=\"1-1-1-1\">\n                F\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                <strong class=\"block text-[14px] font-semibold leading-tight\" data-kid=\"1-1-1-2-1\">\n                    Falco\n                </strong>\n                <small class=\"text-[11px] text-white/55\" data-kid=\"1-1-1-2-2\">\n                    Room desk\n                </small>\n            </span>\n        </a>\n        <nav class=\"mt-2 px-3 space-y-1\" data-kid=\"1-1-2\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-1\">\n                <i class=\"ti ti-layout-dashboard text-[16px]\" data-kid=\"1-1-2-1-1\">\n                </i>\n                Overview\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-2\">\n                <i class=\"ti ti-building-hotel text-[16px]\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Hotels\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-3\">\n                <i class=\"ti ti-receipt text-[16px]\" data-kid=\"1-1-2-3-1\">\n                </i>\n                Purchases\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-4\">\n                <i class=\"ti ti-building-store text-[16px]\" data-kid=\"1-1-2-4-1\">\n                </i>\n                Agencies\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-5\">\n                <i class=\"ti ti-inbox text-[16px]\" data-kid=\"1-1-2-5-1\">\n                </i>\n                Requests\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[13.5px] font-medium text-white/65 hover:bg-white/[.07] hover:text-white transition-colors duration-150\" data-kid=\"1-1-2-6\">\n                <i class=\"ti ti-bed text-[16px]\" data-kid=\"1-1-2-6-1\">\n                </i>\n                Allotments\n            </a>\n        </nav>\n        <div class=\"mt-auto p-3 border-t border-white/10 space-y-1\" data-kid=\"1-1-3\">\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[12.5px] font-medium text-white/60 hover:bg-white/[.07] hover:text-white transition-colors\" data-kid=\"1-1-3-1\">\n                <i class=\"ti ti-external-link text-[14px]\" data-kid=\"1-1-3-1-1\">\n                </i>\n                Public site\n            </a>\n            <a class=\"flex items-center gap-3 rounded-lg px-3 py-2 text-[12.5px] font-medium text-white/60 hover:bg-white/[.07] hover:text-white transition-colors\" data-kid=\"1-1-3-2\">\n                <i class=\"ti ti-logout text-[14px]\" data-kid=\"1-1-3-2-1\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <!-- Content -->\n    <main class=\"ml-[260px] flex-1 px-10 py-8\" data-kid=\"1-2\">\n        <!-- Page header -->\n        <header class=\"flex items-end justify-between gap-6 mb-7\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"fd text-[27px] font-semibold tracking-tight leading-none\" data-kid=\"1-2-1-1-1\">\n                    Interface states\n                </h1>\n                <p class=\"mt-2 text-[14px] text-[#5c6470] max-w-[560px]\" data-kid=\"1-2-1-1-2\">\n                    How the room desk responds — loading, feedback and recovery for every write action.\n                </p>\n            </div>\n            <span class=\"fm shrink-0 text-[11px] text-[#5c6470] rounded-md border border-[#dfe5ec] bg-white px-3 py-1.5\" data-kid=\"1-2-1-2\">\n                Today · 1 Oct 2026 · Riyadh\n            </span>\n        </header>\n        <!-- FLOW 1 — Loading the desk -->\n        <section class=\"bg-white border border-[#dfe5ec] rounded-xl p-6\" data-kid=\"1-2-2\">\n            <div class=\"flex items-baseline justify-between mb-5\" data-kid=\"1-2-2-1\">\n                <h2 class=\"fd text-[19px] font-semibold\" data-kid=\"1-2-2-1-1\">\n                    Loading the desk\n                </h2>\n                <span class=\"fm text-[10.5px] uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-2-1-2\">\n                    flow · load\n                </span>\n            </div>\n            <div class=\"flex items-stretch gap-3\" data-kid=\"1-2-2-2\">\n                <div class=\"flex-[2.1] min-w-0 rounded-lg bg-[#f7f4ef] p-4\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"flex gap-4 mb-4\" data-kid=\"1-2-2-2-1-1\">\n                        <div data-kid=\"1-2-2-2-1-1-1\">\n                            <span class=\"block text-[10px] font-semibold uppercase tracking-wide text-[#5c6470] mb-1.5\" data-kid=\"1-2-2-2-1-1-1-1\">\n                                Held today\n                            </span>\n                            <div class=\"skel h-6 w-[64px] rounded\" data-kid=\"1-2-2-2-1-1-1-2\">\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-1-2\">\n                            <span class=\"block text-[10px] font-semibold uppercase tracking-wide text-[#5c6470] mb-1.5\" data-kid=\"1-2-2-2-1-1-2-1\">\n                                Open today\n                            </span>\n                            <div class=\"skel h-6 w-[48px] rounded\" data-kid=\"1-2-2-2-1-1-2-2\">\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-1-3\">\n                            <span class=\"block text-[10px] font-semibold uppercase tracking-wide text-[#5c6470] mb-1.5\" data-kid=\"1-2-2-2-1-1-3-1\">\n                                Requests\n                            </span>\n                            <div class=\"skel h-6 w-[40px] rounded\" data-kid=\"1-2-2-2-1-1-3-2\">\n                            </div>\n                        </div>\n                        <div class=\"ms-auto text-end\" data-kid=\"1-2-2-2-1-1-4\">\n                            <span class=\"block text-[10px] font-semibold uppercase tracking-wide text-[#5c6470] mb-1.5\" data-kid=\"1-2-2-2-1-1-4-1\">\n                                Capacity\n                            </span>\n                            <div class=\"skel h-2.5 w-[130px] rounded-full\" data-kid=\"1-2-2-2-1-1-4-2\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"rounded-md bg-white border border-[#e6ebf0] p-3\" data-kid=\"1-2-2-2-1-2\">\n                        <div class=\"grid grid-cols-[14px_1.5fr_1.7fr_.5fr_1fr_.5fr_.7fr_.7fr_.7fr] gap-x-2.5 items-center mb-2\" data-kid=\"1-2-2-2-1-2-1\">\n                            <span data-kid=\"1-2-2-2-1-2-1-1\">\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-2-2-1-2-1-2\">\n                                Agency\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-2-2-1-2-1-3\">\n                                Hotel / room\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470] text-end\" data-kid=\"1-2-2-2-1-2-1-4\">\n                                Qty\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470]\" data-kid=\"1-2-2-2-1-2-1-5\">\n                                Stay\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470] text-end\" data-kid=\"1-2-2-2-1-2-1-6\">\n                                Nights\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470] text-end\" data-kid=\"1-2-2-2-1-2-1-7\">\n                                Cost\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470] text-end\" data-kid=\"1-2-2-2-1-2-1-8\">\n                                Sell\n                            </span>\n                            <span class=\"text-[9.5px] font-semibold uppercase tracking-wide text-[#5c6470] text-end\" data-kid=\"1-2-2-2-1-2-1-9\">\n                                Margin\n                            </span>\n                        </div>\n                        <div class=\"space-y-2.5\" data-kid=\"1-2-2-2-1-2-2\">\n                            <div class=\"grid grid-cols-[14px_1.5fr_1.7fr_.5fr_1fr_.5fr_.7fr_.7fr_.7fr] gap-x-2.5 items-center\" data-kid=\"1-2-2-2-1-2-2-1\">\n                                <div class=\"skel w-2.5 h-2.5 rounded-full\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"skeleton dot icon\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"skeleton table row cell 1\" style=\"width:88%\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded\" data-kid=\"1-2-2-2-1-2-2-1-3\" data-name=\"skeleton table row cell 2\" style=\"width:72%\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded ms-auto\" data-kid=\"1-2-2-2-1-2-2-1-4\" data-name=\"skeleton table row cell 3\" style=\"width:55%\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded\" data-kid=\"1-2-2-2-1-2-2-1-5\" data-name=\"skeleton table row cell 4\" style=\"width:90%\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded ms-auto\" data-kid=\"1-2-2-2-1-2-2-1-6\" data-name=\"skeleton table row cell 5\" style=\"width:45%\">\n                                </div>\n                                <div class=\"skel h-2.5 rounded ms-auto\" data-kid=\"1-2-2-2-1-2-2-1-7\" data-name=\"skeleton table row cell 6\" style=\"width:95%\">\n                                </div>\n                                <div class=\"